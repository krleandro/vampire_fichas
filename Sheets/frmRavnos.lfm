            <tab name="tabAntecedentes" title="4. Antecedentes &amp; Qualidades">
                <scrollBox align="client" padding="{left=10, right=10, top=10, bottom=10}">
                    <layout align="top" height="880">
                        <rectangle align="top" height="440" color="#16161E" strokeColor="#3A1C24" strokeSize="1" xradius="6" yradius="6" padding="{left=12, right=12, top=8, bottom=8}" margins="{bottom=10}">
                            <label align="top" height="22" text="ANTECEDENTES V20 &amp; AÇÕES DE REDE" fontColor="#9C4A1A" fontSize="12" fontStyle="bold" horzTextAlign="leading"/>
                            <layout align="top" height="28" margins="{top=4, bottom=6}"><label align="left" width="110" text="Faixa Recursos:" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/><label align="left" width="245" field="recursos_faixa" fontColor="#D9B45B" fontSize="11" fontStyle="bold" horzTextAlign="leading"/><label align="left" width="80" text="Recipientes:" fontColor="#9E9890" fontSize="10" horzTextAlign="trailing" margins="{right=4}"/><label align="left" width="36" field="rebanho_recipientes" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center"/><button align="right" width="195" text="Caçar (Rebanho + Domínio)" fontSize="11" fontStyle="bold"><event name="onClick">if sheet ~= nil then V20Bridge.huntWithHerdDomain(sheet) end</event></button></layout>
                            <layout align="top" height="26" margins="{bottom=2}">
