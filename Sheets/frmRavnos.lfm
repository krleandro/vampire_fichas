                                <button align="right" width="82" text="Atacar" fontSize="10" fontStyle="bold">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.rollWeaponAttack(sheet, 2) end</event>
                                </button>
                            </layout>
                            <layout align="top" height="28" margins="{bottom=3}">
                                <edit align="left" width="155" field="arma3_nome" textPrompt="Arma / Manobra #3" fontColor="#ECE8E1" fontSize="11" margins="{right=6}"/>
                                <comboBox align="left" width="115" field="arma3_attr" items="{'Força', 'Destreza', 'Vigor', 'Carisma', 'Manipulação', 'Aparência', 'Percepção', 'Inteligência', 'Raciocínio'}" values="{'attr_forca', 'attr_destreza', 'attr_vigor', 'attr_carisma', 'attr_manipulacao', 'attr_aparencia', 'attr_percepcao', 'attr_inteligencia', 'attr_raciocinio'}" fontColor="#ECE8E1" fontSize="10" margins="{right=4}"/>
                                <comboBox align="left" width="135" field="arma3_hab" items="{'Prontidão', 'Esportes', 'Consciência', 'Briga', 'Empatia', 'Expressão', 'Intimidação', 'Liderança', 'Manha', 'Lábia', 'Empatia c/ Animais', 'Ofícios', 'Condução', 'Etiqueta', 'Armas de Fogo', 'Arrombamento', 'Armas Brancas', 'Performance', 'Furtividade', 'Sobrevivência', 'Acadêmicos', 'Computador', 'Finanças', 'Investigação', 'Direito', 'Medicina', 'Ocultismo', 'Política', 'Ciências', 'Tecnologia', 'Autocontrole/Instinto', 'Coragem'}" values="{'hab_prontidao', 'hab_esportes', 'hab_consciencia', 'hab_briga', 'hab_empatia', 'hab_expressao', 'hab_intimidacao', 'hab_lideranca', 'hab_manha', 'hab_labia', 'hab_empatia_animais', 'hab_oficios', 'hab_conducao', 'hab_etiqueta', 'hab_armas_fogo', 'hab_arrombamento', 'hab_armas_brancas', 'hab_performance', 'hab_furtividade', 'hab_sobrevivencia', 'hab_academicos', 'hab_computador', 'hab_financas', 'hab_investigacao', 'hab_direito', 'hab_medicina', 'hab_ocultismo', 'hab_politica', 'hab_ciencias', 'hab_tecnologia', 'hab_autocontrole_ref', 'hab_coragem_ref'}" fontColor="#ECE8E1" fontSize="10" margins="{right=4}"/>
