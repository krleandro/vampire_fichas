                                <label align="left" width="48" field="xp_disponivel" fontColor="#D9B45B" fontSize="12" fontStyle="bold" horzTextAlign="center" margins="{right=14}"/>
                                <checkBox name="chkXpExigeAprovacao" align="left" width="185" field="xp_exige_aprovacao" text="Exigir Aprovação Mestre" fontColor="#ECE8E1" fontSize="10"/>
                                <checkBox name="chkNarradorOverride" align="left" width="165" field="narrador_override" text="Override do Narrador" fontColor="#E05A5A" fontSize="10"/>
                            </layout>
                            <layout align="top" height="28" margins="{top=6}">
                                <comboBox name="cmbXpLojaTipo" align="left" width="195" field="xp_loja_tipo" items="{'Automático (pelo Campo)', 'Atributo (Atual x4)', 'Habilidade (Nova 3 / Atual x2)', 'Disciplina (Nova 10 / Clã x5 / Fora x7)', 'Linha Secundária (Nova 7 / Atual x4)', 'Virtude (Atual x2)', 'Moralidade (Atual x2)', 'Força de Vontade (Atual x1)'}" values="{'auto', 'attribute', 'ability', 'discipline', 'secondary_path', 'virtue', 'morality', 'willpower'}" fontColor="#ECE8E1" fontSize="10" margins="{right=6}"/>
                                <comboBox name="cmbXpLojaCampo" align="left" width="175" field="xp_loja_campo" items="{'Atributo: Força', 'Atributo: Destreza', 'Atributo: Vigor', 'Atributo: Carisma', 'Atributo: Manipulação', 'Atributo: Aparência', 'Atributo: Percepção', 'Atributo: Inteligência', 'Atributo: Raciocínio', 'Habilidade: Prontidão', 'Habilidade: Esportes', 'Habilidade: Consciência', 'Habilidade: Briga', 'Habilidade: Empatia', 'Habilidade: Expressão', 'Habilidade: Intimidação', 'Habilidade: Liderança', 'Habilidade: Manha', 'Habilidade: Lábia', 'Habilidade: Empatia c/ Animais', 'Habilidade: Ofícios', 'Habilidade: Condução', 'Habilidade: Etiqueta', 'Habilidade: Armas de Fogo', 'Habilidade: Arrombamento', 'Habilidade: Armas Brancas', 'Habilidade: Performance', 'Habilidade: Furtividade', 'Habilidade: Sobrevivência', 'Habilidade: Acadêmicos', 'Habilidade: Computador', 'Habilidade: Finanças', 'Habilidade: Investigação', 'Habilidade: Direito', 'Habilidade: Medicina', 'Habilidade: Ocultismo', 'Habilidade: Política', 'Habilidade: Ciências', 'Habilidade: Tecnologia', 'Hab. Secundária #1', 'Hab. Secundária #2', 'Hab. Secundária #3', 'Hab. Secundária #4', 'Disciplina Slot #1', 'Disciplina Slot #2', 'Disciplina Slot #3', 'Disciplina Slot #4', 'Disciplina Slot #5', 'Disciplina Slot #6', 'Disciplina Slot #7', 'Disciplina Slot #8', 'Disciplina Slot #9', 'Linha Secundária #1', 'Linha Secundária #2', 'Linha Secundária #3', 'Linha Secundária #4', 'Virtude 1 (Consciência/Convicção)', 'Virtude 2 (Autocontrole/Instinto)', 'Virtude 3 (Coragem)', 'Moralidade / Humanidade / Trilha', 'Força de Vontade Permanente'}" values="{'attr_forca', 'attr_destreza', 'attr_vigor', 'attr_carisma', 'attr_manipulacao', 'attr_aparencia', 'attr_percepcao', 'attr_inteligencia', 'attr_raciocinio', 'hab_prontidao', 'hab_esportes', 'hab_consciencia', 'hab_briga', 'hab_empatia', 'hab_expressao', 'hab_intimidacao', 'hab_lideranca', 'hab_manha', 'hab_labia', 'hab_empatia_animais', 'hab_oficios', 'hab_conducao', 'hab_etiqueta', 'hab_armas_fogo', 'hab_arrombamento', 'hab_armas_brancas', 'hab_performance', 'hab_furtividade', 'hab_sobrevivencia', 'hab_academicos', 'hab_computador', 'hab_financas', 'hab_investigacao', 'hab_direito', 'hab_medicina', 'hab_ocultismo', 'hab_politica', 'hab_ciencias', 'hab_tecnologia', 'hab_extra1_val', 'hab_extra2_val', 'hab_extra3_val', 'hab_extra4_val', 'disc_slot1_nivel', 'disc_slot2_nivel', 'disc_slot3_nivel', 'disc_slot4_nivel', 'disc_slot5_nivel', 'disc_slot6_nivel', 'disc_slot7_nivel', 'disc_slot8_nivel', 'disc_slot9_nivel', 'bm_sec1_nivel', 'bm_sec2_nivel', 'bm_sec3_nivel', 'bm_sec4_nivel', 'virtude1_val', 'virtude2_val', 'virtude3_val', 'moralidade_val', 'fdv_perm'}" fontColor="#ECE8E1" fontSize="10" margins="{right=6}"/>
                                <comboBox name="cmbXpLojaCatCusto" align="left" width="140" field="xp_loja_cat_custo" items="{'Automático (pela Ficha)', 'De Clã (x5)', 'Caitiff (x6)', 'Fora do Clã (x7)'}" values="{'auto', 'cla', 'caitiff', 'fora_cla'}" fontColor="#ECE8E1" fontSize="10" margins="{right=6}"/>
                                <edit name="edtXpLojaDescricao" align="client" field="xp_loja_descricao" textPrompt="Rótulo p/ Auditoria" fontColor="#9E9890" fontSize="10" margins="{right=6}"/>
                                <button name="btnSolicitarXP" align="right" width="135" text="Solicitar Evolução" fontSize="10" fontStyle="bold">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.submitOrApproveXP(sheet, 'submit', nil) end</event>
                                </button>
                            </layout>
                            <layout align="top" height="30" margins="{top=8}">
                                <label align="left" width="75" text="Pendente:" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
                                <label align="left" width="85" field="xp_pendente_status" fontColor="#D9B45B" fontSize="11" fontStyle="bold" horzTextAlign="leading"/>
                                <label align="client" field="xp_pendente_desc" fontColor="#ECE8E1" fontSize="10" horzTextAlign="leading"/>
                                <button name="btnRecusarXP" align="right" width="115" text="Recusar (Mestre)" fontSize="10" margins="{left=6}">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.submitOrApproveXP(sheet, 'reject', nil) end</event>
                                </button>
                                <button name="btnAprovarXP" align="right" width="115" text="Aprovar (Mestre)" fontSize="10" fontStyle="bold">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.submitOrApproveXP(sheet, 'approve', nil) end</event>
                                </button>
                            </layout>
                        </rectangle>

                        <rectangle align="top" height="230" color="#16161E" strokeColor="#3A1C24" strokeSize="1" xradius="6" yradius="6" padding="{left=12, right=12, top=10, bottom=10}" margins="{bottom=10}">
                            <label align="top" height="22" text="HISTÓRICO AUDITÁVEL IMUTÁVEL DE XP E ALTERAÇÕES DO NARRADOR" fontColor="#9C4A1A" fontSize="11" fontStyle="bold" horzTextAlign="leading"/>
                            <textEditor align="client" field="auditoria_xp_log" readOnly="true" fontColor="#ECE8E1" fontSize="11" margins="{top=4}"/>
                        </rectangle>

                        <rectangle align="top" height="170" color="#16161E" strokeColor="#3A1C24" strokeSize="1" xradius="6" yradius="6" padding="{left=12, right=12, top=10, bottom=10}">
                            <label align="top" height="22" text="DIÁRIO DA CRÔNICA, LAÇOS DE SANGUE &amp; ANOTAÇÕES" fontColor="#9C4A1A" fontSize="11" fontStyle="bold" horzTextAlign="leading"/>
                            <textEditor align="client" field="notas_cronica" fontColor="#ECE8E1" fontSize="11" margins="{top=4}"/>
                        </rectangle>
                    </layout>
                </scrollBox>
            </tab>
            <tab name="tabMagiaSangue" title="8. Magia do Sangue &amp; Rituais" visible="false">
                <scrollBox align="client" padding="{left=10, right=10, top=10, bottom=10}">
                    <layout align="top" height="720">
                        <rectangle align="top" height="165" color="#16161E" strokeColor="#9C4A1A" strokeSize="1" xradius="6" yradius="6" padding="{left=12, right=12, top=8, bottom=8}" margins="{bottom=10}">
                            <label align="top" height="22" text="LINHAS PRIMÁRIAS — TAUMATURGIA &amp; NECROMANCIA (SINCRONIZADAS COM A ABA 3)" fontColor="#9C4A1A" fontSize="12" fontStyle="bold" horzTextAlign="leading"/>
                            <layout align="top" height="28" margins="{top=4}">
                                <label align="left" width="125" text="Prim. Taumaturgia:" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
                                <comboBox name="cmbBmThauPrimId" align="left" width="215" field="bm_thau_prim_id" items="{'Linha do Sangue', 'Sedutor das Chamas', 'Movimento da Mente', 'Linha da Conjuração', 'Mãos da Destruição', 'Controle do Clima'}" values="{'path_of_blood', 'lure_of_flames', 'movement_of_the_mind', 'path_of_conjuring', 'hands_of_destruction', 'weather_control'}" fontColor="#ECE8E1" fontSize="11" margins="{right=8}"/>
                                <label align="left" width="42" text="Nível:" fontColor="#9E9890" fontSize="10" horzTextAlign="trailing" margins="{right=4}"/>
                                <label align="left" width="28" field="bm_thau_prim_nivel" fontColor="#D9B45B" fontSize="12" fontStyle="bold" horzTextAlign="center" margins="{right=8}"/>
                                <comboBox name="cmbBmThauPrimPwrLvl" align="left" width="115" field="bm_thau_prim_pwr_lvl" items="{'Poder Nv 1', 'Poder Nv 2', 'Poder Nv 3', 'Poder Nv 4', 'Poder Nv 5'}" values="{'1', '2', '3', '4', '5'}" fontColor="#ECE8E1" fontSize="10" margins="{right=8}"/>
                                <button name="btnBmThauPrimAtivar" align="right" width="190" text="Ativar Linha Taumaturgia" fontSize="10" fontStyle="bold">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.activatePrimaryBloodMagic(sheet, 'thaumaturgy', nil) end</event>
                                </button>
                            </layout>
                            <label align="top" height="22" field="bm_thau_prim_resumo" fontColor="#9E9890" fontSize="10" horzTextAlign="leading" margins="{top=2}"/>
                            <layout align="top" height="28" margins="{top=6}">
                                <label align="left" width="125" text="Prim. Necromancia:" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
                                <comboBox name="cmbBmNecroPrimId" align="left" width="215" field="bm_necro_prim_id" items="{'Linha do Sepulcro', 'Linha dos Ossos', 'Linha das Cinzas'}" values="{'sepulchre_path', 'bone_path', 'ash_path'}" fontColor="#ECE8E1" fontSize="11" margins="{right=8}"/>
                                <label align="left" width="42" text="Nível:" fontColor="#9E9890" fontSize="10" horzTextAlign="trailing" margins="{right=4}"/>
                                <label align="left" width="28" field="bm_necro_prim_nivel" fontColor="#D9B45B" fontSize="12" fontStyle="bold" horzTextAlign="center" margins="{right=8}"/>
                                <comboBox name="cmbBmNecroPrimPwrLvl" align="left" width="115" field="bm_necro_prim_pwr_lvl" items="{'Poder Nv 1', 'Poder Nv 2', 'Poder Nv 3', 'Poder Nv 4', 'Poder Nv 5'}" values="{'1', '2', '3', '4', '5'}" fontColor="#ECE8E1" fontSize="10" margins="{right=8}"/>
                                <button name="btnBmNecroPrimAtivar" align="right" width="190" text="Ativar Linha Necromancia" fontSize="10" fontStyle="bold">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.activatePrimaryBloodMagic(sheet, 'necromancy', nil) end</event>
                                </button>
                            </layout>
                            <label align="client" field="bm_necro_prim_resumo" fontColor="#9E9890" fontSize="10" horzTextAlign="leading" margins="{top=2}"/>
                        </rectangle>

                        <label align="top" height="20" text="LINHAS SECUNDÁRIAS V20 (EXIGE PRIMÁRIA &gt;= 2 • NOVA: 7 XP • EVOLUÇÃO: ATUAL x4 XP NA ABA 7)" fontColor="#9C4A1A" fontSize="11" fontStyle="bold" horzTextAlign="leading" margins="{bottom=4}"/>
                        <rectangle align="top" height="60" color="#16161E" strokeColor="#3A1C24" strokeSize="1" xradius="5" yradius="5" padding="{left=10, right=10, top=6, bottom=6}" margins="{bottom=6}">
