                                    <event name="onClick">if sheet ~= nil then V20Bridge.rollRavnosVice(sheet) end</event>
                                </button>
                            </layout>
                        </rectangle>
                    </layout>
                </scrollBox>
            </tab>
            <tab name="tabExperiencia" title="7. Experiência &amp; Narrador">
                <scrollBox align="client" padding="{left=10, right=10, top=10, bottom=10}">
                    <layout align="top" height="760">

                        <rectangle align="top" height="190" color="#16161E" strokeColor="#3A1C24" strokeSize="1" xradius="6" yradius="6" padding="{left=12, right=12, top=10, bottom=10}" margins="{bottom=10}">
                            <label align="top" height="22" text="EVOLUÇÃO POR EXPERIÊNCIA (XP) &amp; FILA DE APROVAÇÃO DO NARRADOR" fontColor="#9C4A1A" fontSize="12" fontStyle="bold" horzTextAlign="leading"/>
                            <layout align="top" height="28" margins="{top=4}">
                                <label align="left" width="68" text="XP Total:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
