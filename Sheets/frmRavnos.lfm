                            <layout align="top" height="26">
                                <label align="left" width="66" text="CLÃ #1" fontColor="#9C4A1A" fontSize="10" fontStyle="bold" horzTextAlign="leading"/>
                                <comboBox name="cmbDiscSlotId1" align="left" width="185" field="disc_slot1_id" items="{'— Nenhuma —', 'Animalismo', 'Auspícios', 'Rapidez', 'Quimerismo', 'Demência', 'Dominação', 'Fortitude', 'Necromancia (Sepulcro)', 'Ofuscação', 'Tenebrosidade', 'Potência', 'Presença', 'Metamorfose', 'Quietus', 'Serpentis', 'Taumaturgia (Sangue)', 'Vicissitude'}" values="{'', 'animalism', 'auspex', 'celerity', 'chimerstry', 'dementation', 'dominate', 'fortitude', 'necromancy', 'obfuscate', 'obtenebration', 'potence', 'presence', 'protean', 'quietus', 'serpentis', 'thaumaturgy', 'vicissitude'}" fontColor="#ECE8E1" fontSize="11" margins="{right=6}"/>
                                <label align="left" width="36" text="Nível:" fontColor="#9E9890" fontSize="10" horzTextAlign="trailing" margins="{right=4}"/>
                                <edit name="edtDiscSlotNivel1" align="left" width="36" field="disc_slot1_nivel" type="number" fontColor="#D9B45B" fontSize="11" fontStyle="bold" horzTextAlign="center" margins="{right=6}"/>
                                <comboBox name="cmbDiscSlotCat1" align="left" width="140" field="disc_slot1_cat" items="{'De Clã (x5)', 'Fora do Clã (x7)', 'Caitiff (x6)', 'Linha Secundária (x4)'}" values="{'cla', 'fora_cla', 'caitiff', 'linha_secundaria'}" fontColor="#9E9890" fontSize="10" margins="{right=6}"/>
                                <comboBox name="cmbDiscSlotPwrLvl1" align="left" width="110" field="disc_slot1_pwr_lvl" items="{'Poder Nv 1', 'Poder Nv 2', 'Poder Nv 3', 'Poder Nv 4', 'Poder Nv 5'}" values="{'1', '2', '3', '4', '5'}" fontColor="#ECE8E1" fontSize="10" margins="{right=6}"/>
