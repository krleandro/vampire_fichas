                            </layout>
                            <layout align="top" height="28" margins="{bottom=3}">
                                <edit align="left" width="155" field="arma2_nome" textPrompt="Arma / Manobra #2" fontColor="#ECE8E1" fontSize="11" margins="{right=6}"/>
