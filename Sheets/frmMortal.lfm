<?xml version="1.0" encoding="UTF-8"?>
<form name="frmMortal" formType="sheetTemplate" dataType="br.com.v20.Mortal" title="Vampiro V20 - Mortal" align="client" theme="dark">

    <script>
        <![CDATA[
        local V20Bridge = _G.V20Bridge or require("Adapter.firecast_bridge")

        local function atualizarVisibilidadeMortal(formObj)
            if formObj == nil or sheet == nil then return end
            local modo = sheet.mortal_sobrenatural_modo or "humano"
            local isCarnical = (modo == "carnical")
            local isNumina = (modo == "numina")
            if formObj.pnlHeaderBlood ~= nil then formObj.pnlHeaderBlood:setVisible(isCarnical) end
            if formObj.pnlCarnical ~= nil then formObj.pnlCarnical:setVisible(isCarnical) end
            if formObj.pnlNumina ~= nil then formObj.pnlNumina:setVisible(isNumina) end
            if formObj.btnFrenesiCarnical ~= nil then formObj.btnFrenesiCarnical:setVisible(isCarnical) end
        end

        local PERM_EDITS = { "edtFreebieAttributes", "edtFreebieAbilities", "edtFreebieBackgrounds", "edtFreebieVirtues", "edtFreebieMorality", "edtFreebieWillpower", "edt_attr_forca", "edt_spec_attr_forca", "edt_attr_destreza", "edt_spec_attr_destreza", "edt_attr_vigor", "edt_spec_attr_vigor", "edt_attr_carisma", "edt_spec_attr_carisma", "edt_attr_manipulacao", "edt_spec_attr_manipulacao", "edt_attr_aparencia", "edt_spec_attr_aparencia", "edt_attr_percepcao", "edt_spec_attr_percepcao", "edt_attr_inteligencia", "edt_spec_attr_inteligencia", "edt_attr_raciocinio", "edt_spec_attr_raciocinio", "edt_hab_prontidao", "edt_spec_hab_prontidao", "edt_hab_esportes", "edt_spec_hab_esportes", "edt_hab_consciencia", "edt_spec_hab_consciencia", "edt_hab_briga", "edt_spec_hab_briga", "edt_hab_empatia", "edt_spec_hab_empatia", "edt_hab_expressao", "edt_spec_hab_expressao", "edt_hab_intimidacao", "edt_spec_hab_intimidacao", "edt_hab_lideranca", "edt_spec_hab_lideranca", "edt_hab_manha", "edt_spec_hab_manha", "edt_hab_labia", "edt_spec_hab_labia", "edt_hab_empatia_animais", "edt_spec_hab_empatia_animais", "edt_hab_oficios", "edt_spec_hab_oficios", "edt_hab_conducao", "edt_spec_hab_conducao", "edt_hab_etiqueta", "edt_spec_hab_etiqueta", "edt_hab_armas_fogo", "edt_spec_hab_armas_fogo", "edt_hab_arrombamento", "edt_spec_hab_arrombamento", "edt_hab_armas_brancas", "edt_spec_hab_armas_brancas", "edt_hab_performance", "edt_spec_hab_performance", "edt_hab_furtividade", "edt_spec_hab_furtividade", "edt_hab_sobrevivencia", "edt_spec_hab_sobrevivencia", "edt_hab_academicos", "edt_spec_hab_academicos", "edt_hab_computador", "edt_spec_hab_computador", "edt_hab_financas", "edt_spec_hab_financas", "edt_hab_investigacao", "edt_spec_hab_investigacao", "edt_hab_direito", "edt_spec_hab_direito", "edt_hab_medicina", "edt_spec_hab_medicina", "edt_hab_ocultismo", "edt_spec_hab_ocultismo", "edt_hab_politica", "edt_spec_hab_politica", "edt_hab_ciencias", "edt_spec_hab_ciencias", "edt_hab_tecnologia", "edt_spec_hab_tecnologia", "edtHabExtraNome1", "edtHabExtraVal1", "edtHabExtraEspec1", "edtHabExtraNome2", "edtHabExtraVal2", "edtHabExtraEspec2", "edtHabExtraNome3", "edtHabExtraVal3", "edtHabExtraEspec3", "edtHabExtraNome4", "edtHabExtraVal4", "edtHabExtraEspec4", "edtDiscSlotNivel1", "edtDiscSlotNivel2", "edtDiscSlotNivel3", "edtDiscSlotNivel4", "edtNumina_true_faith", "edtNumina_hedge_magic", "edtNumina_psychic", "edtBg_allies", "edtBg_alternate_identity", "edtBg_contacts", "edtBg_domain", "edtBg_fame", "edtBg_herd", "edtBg_influence", "edtBg_mentor", "edtBg_resources", "edtBg_retainers", "edtBg_status", "edtMfNome1", "edtMfPontos1", "edtMfNome2", "edtMfPontos2", "edtMfNome3", "edtMfPontos3", "edtMfNome4", "edtMfPontos4", "edtMfNome5", "edtMfPontos5", "edtMfNome6", "edtMfPontos6", "edtVirtude1Val", "edtVirtude2Val", "edtVirtude3Val", "edtMoralidadeVal", "edtFdvPerm" }
        local PERM_CTRLS = { "cmbMortalPerfil", "btnConcluirCriacao", "btnMinus_attr_forca", "btnPlus_attr_forca", "btnMinus_attr_destreza", "btnPlus_attr_destreza", "btnMinus_attr_vigor", "btnPlus_attr_vigor", "btnMinus_attr_carisma", "btnPlus_attr_carisma", "btnMinus_attr_manipulacao", "btnPlus_attr_manipulacao", "btnMinus_attr_aparencia", "btnPlus_attr_aparencia", "btnMinus_attr_percepcao", "btnPlus_attr_percepcao", "btnMinus_attr_inteligencia", "btnPlus_attr_inteligencia", "btnMinus_attr_raciocinio", "btnPlus_attr_raciocinio", "btnMinus_hab_prontidao", "btnPlus_hab_prontidao", "btnMinus_hab_esportes", "btnPlus_hab_esportes", "btnMinus_hab_consciencia", "btnPlus_hab_consciencia", "btnMinus_hab_briga", "btnPlus_hab_briga", "btnMinus_hab_empatia", "btnPlus_hab_empatia", "btnMinus_hab_expressao", "btnPlus_hab_expressao", "btnMinus_hab_intimidacao", "btnPlus_hab_intimidacao", "btnMinus_hab_lideranca", "btnPlus_hab_lideranca", "btnMinus_hab_manha", "btnPlus_hab_manha", "btnMinus_hab_labia", "btnPlus_hab_labia", "btnMinus_hab_empatia_animais", "btnPlus_hab_empatia_animais", "btnMinus_hab_oficios", "btnPlus_hab_oficios", "btnMinus_hab_conducao", "btnPlus_hab_conducao", "btnMinus_hab_etiqueta", "btnPlus_hab_etiqueta", "btnMinus_hab_armas_fogo", "btnPlus_hab_armas_fogo", "btnMinus_hab_arrombamento", "btnPlus_hab_arrombamento", "btnMinus_hab_armas_brancas", "btnPlus_hab_armas_brancas", "btnMinus_hab_performance", "btnPlus_hab_performance", "btnMinus_hab_furtividade", "btnPlus_hab_furtividade", "btnMinus_hab_sobrevivencia", "btnPlus_hab_sobrevivencia", "btnMinus_hab_academicos", "btnPlus_hab_academicos", "btnMinus_hab_computador", "btnPlus_hab_computador", "btnMinus_hab_financas", "btnPlus_hab_financas", "btnMinus_hab_investigacao", "btnPlus_hab_investigacao", "btnMinus_hab_direito", "btnPlus_hab_direito", "btnMinus_hab_medicina", "btnPlus_hab_medicina", "btnMinus_hab_ocultismo", "btnPlus_hab_ocultismo", "btnMinus_hab_politica", "btnPlus_hab_politica", "btnMinus_hab_ciencias", "btnPlus_hab_ciencias", "btnMinus_hab_tecnologia", "btnPlus_hab_tecnologia", "cmbDiscSlotId1", "cmbDiscSlotId2", "cmbDiscSlotId3", "cmbDiscSlotId4", "chkMfAtivo1", "cmbMfId1", "cmbMfTipo1", "chkMfAtivo2", "cmbMfId2", "cmbMfTipo2", "chkMfAtivo3", "cmbMfId3", "cmbMfTipo3", "chkMfAtivo4", "cmbMfId4", "cmbMfTipo4", "chkMfAtivo5", "cmbMfId5", "cmbMfTipo5", "chkMfAtivo6", "cmbMfId6", "cmbMfTipo6", "chkTamanhoGrande" }
        local MESTRE_EDITS = { "edtXpTotal", "edtXpGasto", "edtCarnicalDiscMax" }
        local MESTRE_CTRLS = { "cmbModoFicha", "chkXpExigeAprovacao", "chkNarradorOverride", "btnAprovarXP", "btnRecusarXP", "cmbMortalSobrenaturalModo" }

        local function atualizarPermissoesModo(self)
            if self == nil or sheet == nil or V20Bridge == nil then return end
            local isMestre = V20Bridge.isStoryteller(sheet)
            local modo = sheet.modo_ficha or "criacao"
            local stOverride = (sheet.narrador_override == true or sheet.narrador_override == "true") and isMestre
            local lockPerm = ((modo == "jogo") and (not stOverride)) or ((modo == "narrador_livre") and (not isMestre))
            for _, nm in ipairs(PERM_EDITS) do
                if self[nm] ~= nil then self[nm]:setReadOnly(lockPerm) end
            end
            for _, nm in ipairs(PERM_CTRLS) do
                if self[nm] ~= nil then self[nm]:setEnabled(not lockPerm) end
            end
            if sheet.cla_id == "nosferatu" and not stOverride then
                if self.edt_attr_aparencia ~= nil then self.edt_attr_aparencia:setReadOnly(true) end
                if self.btnMinus_attr_aparencia ~= nil then self.btnMinus_attr_aparencia:setEnabled(false) end
                if self.btnPlus_attr_aparencia ~= nil then self.btnPlus_attr_aparencia:setEnabled(false) end
            end
            for _, nm in ipairs(MESTRE_EDITS) do
                if self[nm] ~= nil then self[nm]:setReadOnly(not isMestre) end
            end
            for _, nm in ipairs(MESTRE_CTRLS) do
                if self[nm] ~= nil then self[nm]:setEnabled(isMestre) end
            end
            local modoSob = sheet.mortal_sobrenatural_modo or "humano"
            if self.btnFrenesiCarnical ~= nil then self.btnFrenesiCarnical:setVisible(modoSob == "carnical") end
        end
        ]]>
    </script>

    <rectangle align="client" color="#0D0D11">
        <rectangle name="barHeaderTop" align="top" height="74" color="#16161E" strokeColor="#C48F36" strokeSize="1" padding="{left=12, right=12, top=6, bottom=6}">
            <layout align="top" height="28">
                <label align="left" width="175" text="MORTAL / INQUISIDOR (V20)" fontColor="#C48F36" fontSize="13" fontStyle="bold" horzTextAlign="leading"/>
                <label align="left" width="48" text="Nome:" fontColor="#9E9890" fontSize="11" horzTextAlign="trailing" margins="{right=4}"/>
                <edit align="left" width="210" field="nome" textPrompt="Nome do Personagem" fontColor="#ECE8E1" fontSize="12" fontStyle="bold"/>
                <label align="left" width="54" text="Perfil:" fontColor="#9E9890" fontSize="11" horzTextAlign="trailing" margins="{right=4}"/><label align="left" width="90" field="mortal_sobrenatural_modo" fontColor="#D9B45B" fontSize="11" fontStyle="bold" horzTextAlign="center"/>
                <label align="left" width="70" text="Vitalidade:" fontColor="#9E9890" fontSize="11" horzTextAlign="trailing" margins="{left=8, right=4}"/>
                <label align="left" width="120" field="vitalidade_resumo" fontColor="#ECE8E1" fontSize="11" fontStyle="bold" horzTextAlign="leading"/>
                <label align="client" field="vitalidade_alerta" fontColor="#E05A5A" fontSize="11" fontStyle="bold" horzTextAlign="leading"/>
            </layout>
            <layout align="top" height="30" margins="{top=4}">
                <layout name="pnlHeaderBlood" align="left" width="320" visible="false">
                    <label align="left" width="54" text="Sangue:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                    <button align="left" width="24" text="-" fontSize="12" fontStyle="bold">
                        <event name="onClick">if sheet ~= nil then V20Bridge.adjustResource(sheet, 'sangue_atual', -1, 0, 'sangue_max') end</event>
                    </button>
                    <label align="left" width="32" field="sangue_atual" fontColor="#E05A5A" fontSize="12" fontStyle="bold" horzTextAlign="center"/>
                    <label align="left" width="12" text="/" fontColor="#9E9890" fontSize="11" horzTextAlign="center"/>
                    <label align="left" width="28" field="sangue_max" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center"/>
                    <button align="left" width="24" text="+" fontSize="12" fontStyle="bold" margins="{right=8}">
                        <event name="onClick">if sheet ~= nil then V20Bridge.adjustResource(sheet, 'sangue_atual', 1, 0, 'sangue_max') end</event>
                    </button>
                    <label align="left" width="46" text="Turno:" fontColor="#9E9890" fontSize="10" horzTextAlign="trailing"/>
                    <label align="left" width="22" field="sangue_gasto_turno" fontColor="#D9B45B" fontSize="11" horzTextAlign="center"/>
                    <label align="left" width="10" text="/" fontColor="#9E9890" fontSize="10" horzTextAlign="center"/>
                    <label align="left" width="24" field="sangue_por_turno" fontColor="#9E9890" fontSize="11" horzTextAlign="center"/>
                </layout>
                <layout align="left" width="215">
                    <label align="left" width="66" text="FdV Temp:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                    <button align="left" width="24" text="-" fontSize="12" fontStyle="bold">
                        <event name="onClick">if sheet ~= nil then V20Bridge.adjustResource(sheet, 'fdv_temp', -1, 0, 'fdv_perm') end</event>
                    </button>
                    <label align="left" width="28" field="fdv_temp" fontColor="#D9B45B" fontSize="12" fontStyle="bold" horzTextAlign="center"/>
                    <label align="left" width="12" text="/" fontColor="#9E9890" fontSize="11" horzTextAlign="center"/>
                    <label align="left" width="28" field="fdv_perm" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center"/>
                    <button align="left" width="24" text="+" fontSize="12" fontStyle="bold">
                        <event name="onClick">if sheet ~= nil then V20Bridge.adjustResource(sheet, 'fdv_temp', 1, 0, 'fdv_perm') end</event>
                    </button>
                </layout>
                <button align="right" width="94" text="Novo Turno" fontSize="11" margins="{left=4}">
                    <event name="onClick">if sheet ~= nil then V20Bridge.newTurn(sheet) end</event>
                </button>
                <button align="right" width="76" text="Curar" fontSize="11" margins="{left=4}">
                    <event name="onClick">if sheet ~= nil then V20Bridge.healDamage(sheet, 'bashing') end</event>
                </button>
                
            </layout>
        </rectangle>
        <rectangle name="barFooterRoller" align="bottom" height="76" color="#16161E" strokeColor="#24303E" strokeSize="1" padding="{left=12, right=12, top=6, bottom=6}">
            <layout align="top" height="30">
                <label align="left" width="58" text="Atributo:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                <comboBox align="left" width="145" field="roll_attr_id" items="{'Força', 'Destreza', 'Vigor', 'Carisma', 'Manipulação', 'Aparência', 'Percepção', 'Inteligência', 'Raciocínio', 'Força de Vontade (Poder)', 'Coragem (Virtude)'}" values="{'attr_forca', 'attr_destreza', 'attr_vigor', 'attr_carisma', 'attr_manipulacao', 'attr_aparencia', 'attr_percepcao', 'attr_inteligencia', 'attr_raciocinio', 'attr_fdv_ref', 'hab_coragem_ref'}" fontColor="#ECE8E1" fontSize="11" margins="{right=8}"/>
                <label align="left" width="68" text="Habilidade:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                <comboBox align="left" width="175" field="roll_hab_id" items="{'— Apenas Atributo —', 'Prontidão', 'Esportes', 'Consciência', 'Briga', 'Empatia', 'Expressão', 'Intimidação', 'Liderança', 'Manha', 'Lábia', 'Empatia c/ Animais', 'Ofícios', 'Condução', 'Etiqueta', 'Armas de Fogo', 'Arrombamento', 'Armas Brancas', 'Performance', 'Furtividade', 'Sobrevivência', 'Acadêmicos', 'Computador', 'Finanças', 'Investigação', 'Direito', 'Medicina', 'Ocultismo', 'Política', 'Ciências', 'Tecnologia', 'Antecedente: Aliados', 'Antecedente: Identidade Alternativa', 'Antecedente: Contatos', 'Antecedente: Domínio', 'Antecedente: Fama', 'Antecedente: Geração', 'Antecedente: Rebanho', 'Antecedente: Influência', 'Antecedente: Mentor', 'Antecedente: Recursos', 'Antecedente: Lacaios', 'Antecedente: Rituais', 'Antecedente: Status', 'Autocontrole/Instinto', 'Coragem'}" values="{'none', 'hab_prontidao', 'hab_esportes', 'hab_consciencia', 'hab_briga', 'hab_empatia', 'hab_expressao', 'hab_intimidacao', 'hab_lideranca', 'hab_manha', 'hab_labia', 'hab_empatia_animais', 'hab_oficios', 'hab_conducao', 'hab_etiqueta', 'hab_armas_fogo', 'hab_arrombamento', 'hab_armas_brancas', 'hab_performance', 'hab_furtividade', 'hab_sobrevivencia', 'hab_academicos', 'hab_computador', 'hab_financas', 'hab_investigacao', 'hab_direito', 'hab_medicina', 'hab_ocultismo', 'hab_politica', 'hab_ciencias', 'hab_tecnologia', 'bg_allies', 'bg_alternate_identity', 'bg_contacts', 'bg_domain', 'bg_fame', 'bg_generation', 'bg_herd', 'bg_influence', 'bg_mentor', 'bg_resources', 'bg_retainers', 'bg_rituals', 'bg_status', 'hab_autocontrole_ref', 'hab_coragem_ref'}" fontColor="#ECE8E1" fontSize="11" margins="{right=8}"/>
                <label align="left" width="46" text="Bônus:" fontColor="#9E9890" fontSize="11" horzTextAlign="trailing" margins="{right=4}"/>
                <edit align="left" width="42" field="roll_bonus_dice" type="number" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center" margins="{right=8}"/>
                <label align="left" width="28" text="Dif:" fontColor="#9E9890" fontSize="11" horzTextAlign="trailing" margins="{right=4}"/>
                <edit align="left" width="40" field="roll_diff" type="number" fontColor="#D9B45B" fontSize="12" fontStyle="bold" horzTextAlign="center" margins="{right=8}"/>
                <button align="right" width="142" text="ROLAR NO CHAT" fontSize="12" fontStyle="bold">
                    <event name="onClick">if sheet ~= nil then V20Bridge.rollFromSheet(sheet) end</event>
                </button>
            </layout>
            <layout align="top" height="28" margins="{top=4}">
                <checkBox align="left" width="82" field="roll_usar_espec" text="Espec. (10=2)" fontColor="#ECE8E1" fontSize="10"/>
                <checkBox align="left" width="84" field="roll_gastar_fdv" text="+1 FdV Auto" fontColor="#D9B45B" fontSize="10"/>
                <checkBox align="left" width="76" field="roll_usar_fama" text="Usar Fama" fontColor="#ECE8E1" fontSize="10"/>
                <checkBox align="left" width="82" field="roll_usar_status" text="Usar Status" fontColor="#ECE8E1" fontSize="10"/>
                <checkBox align="left" width="106" field="roll_ignorar_ferimento" text="Ignorar Ferim." fontColor="#ECE8E1" fontSize="10"/>
                <label align="client" field="roll_equacao_resumo" fontColor="#9E9890" fontSize="11" horzTextAlign="trailing"/>
            </layout>
        </rectangle>

        <tabControl name="pgcPrincipal" align="client" margins="{left=6, right=6, top=6, bottom=6}">
            <tab name="tabCriacao" title="1. Mortal &amp; Criação">
                <scrollBox align="client" padding="{left=10, right=10, top=10, bottom=10}">
                    <layout align="top" height="620">
                        <rectangle align="top" height="180" color="#16161E" strokeColor="#24303E" strokeSize="1" xradius="6" yradius="6" padding="{left=12, right=12, top=10, bottom=10}" margins="{bottom=10}">
                            <label align="top" height="22" text="REGISTRO BIOGRÁFICO HUMANO — VAMPIRO V20" fontColor="#C48F36" fontSize="13" fontStyle="bold" horzTextAlign="leading"/>
                            <layout align="top" height="28" margins="{top=6}">
                                <label align="left" width="75" text="Jogador:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <edit align="left" width="180" field="jogador" fontColor="#ECE8E1" fontSize="11" margins="{right=10}"/>
                                <label align="left" width="70" text="Crônica:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <edit align="left" width="190" field="cronica" fontColor="#ECE8E1" fontSize="11" margins="{right=10}"/>
                                <label align="left" width="75" text="Ocupação:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <edit align="client" field="ocupacao" fontColor="#ECE8E1" fontSize="11"/>
                            </layout>
                            <layout align="top" height="28" margins="{top=6}">
                                <label align="left" width="75" text="Natureza:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <edit align="left" width="180" field="natureza" fontColor="#ECE8E1" fontSize="11" margins="{right=10}"/>
                                <label align="left" width="70" text="Comport.:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <edit align="left" width="190" field="comportamento" fontColor="#ECE8E1" fontSize="11" margins="{right=10}"/>
                                <label align="left" width="75" text="Formação:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <edit align="client" field="formacao" fontColor="#ECE8E1" fontSize="11"/>
                            </layout>
                            <layout align="top" height="28" margins="{top=6}">
                                <label align="left" width="85" text="Perfil V20:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <comboBox name="cmbMortalPerfil" align="left" width="320" field="mortal_perfil" items="{'Mortal Padrão V20 (6/4/3 • 11/7/4 • 21 Bônus)', 'Mortal Heroico (7/5/3 • 13/9/5 • 15 Bônus)'}" values="{'padrao_643', 'heroico_753'}" fontColor="#D9B45B" fontSize="11" margins="{right=14}"/>
                                <label align="left" width="85" text="Modo Ficha:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <comboBox name="cmbModoFicha" align="client" field="modo_ficha" items="{'Criação Validada', 'Modo Jogo (XP)', 'Edição Livre (Narrador)'}" values="{'criacao', 'jogo', 'narrador_livre'}" fontColor="#ECE8E1" fontSize="11"/>
                            </layout>
                        </rectangle>

                        <rectangle align="top" height="240" color="#16161E" strokeColor="#24303E" strokeSize="1" xradius="6" yradius="6" padding="{left=12, right=12, top=10, bottom=10}">
                            <label align="top" height="22" text="ASSISTENTE DE CRIAÇÃO MORTAL V20 (6/4/3 PADRÃO OU 7/5/3 HEROICO)" fontColor="#C48F36" fontSize="12" fontStyle="bold" horzTextAlign="leading"/>
                            <layout align="top" height="28" margins="{top=6}">
                                <label align="left" width="85" text="Bônus Atrib:" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
                                <edit name="edtFreebieAttributes" align="left" width="40" field="freebie_attributes" type="number" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center" margins="{right=10}"/>
                                <label align="left" width="80" text="Bônus Hab:" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
                                <edit name="edtFreebieAbilities" align="left" width="40" field="freebie_abilities" type="number" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center" margins="{right=10}"/>
                                <label align="left" width="85" text="Bônus Antec:" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
