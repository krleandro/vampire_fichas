                            <label align="top" height="22" text="VÍNCULOS HUMANOS, EQUIPAMENTOS CIVIS &amp; CONHECIMENTO DO OCULTO" fontColor="#C48F36" fontSize="12" fontStyle="bold" horzTextAlign="leading"/>
