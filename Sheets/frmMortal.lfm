                    <layout align="top" height="880">
                        <rectangle align="top" height="390" color="#16161E" strokeColor="#24303E" strokeSize="1" xradius="6" yradius="6" padding="{left=12, right=12, top=8, bottom=8}" margins="{bottom=10}">
