                                <comboBox align="left" width="135" field="arma2_hab" items="{'Prontidão', 'Esportes', 'Consciência', 'Briga', 'Empatia', 'Expressão', 'Intimidação', 'Liderança', 'Manha', 'Lábia', 'Empatia c/ Animais', 'Ofícios', 'Condução', 'Etiqueta', 'Armas de Fogo', 'Arrombamento', 'Armas Brancas', 'Performance', 'Furtividade', 'Sobrevivência', 'Acadêmicos', 'Computador', 'Finanças', 'Investigação', 'Direito', 'Medicina', 'Ocultismo', 'Política', 'Ciências', 'Tecnologia', 'Autocontrole/Instinto', 'Coragem'}" values="{'hab_prontidao', 'hab_esportes', 'hab_consciencia', 'hab_briga', 'hab_empatia', 'hab_expressao', 'hab_intimidacao', 'hab_lideranca', 'hab_manha', 'hab_labia', 'hab_empatia_animais', 'hab_oficios', 'hab_conducao', 'hab_etiqueta', 'hab_armas_fogo', 'hab_arrombamento', 'hab_armas_brancas', 'hab_performance', 'hab_furtividade', 'hab_sobrevivencia', 'hab_academicos', 'hab_computador', 'hab_financas', 'hab_investigacao', 'hab_direito', 'hab_medicina', 'hab_ocultismo', 'hab_politica', 'hab_ciencias', 'hab_tecnologia', 'hab_autocontrole_ref', 'hab_coragem_ref'}" fontColor="#ECE8E1" fontSize="10" margins="{right=4}"/>
