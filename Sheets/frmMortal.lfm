                            <label align="top" height="20" text="ATALHOS RÁPIDOS DE COMBATE V20" fontColor="#C48F36" fontSize="11" fontStyle="bold" horzTextAlign="leading"/>
                            <layout align="top" height="28" margins="{top=4}">
                                <button align="left" width="145" text="Iniciativa (1d10+Mod)" fontSize="10" fontStyle="bold" margins="{right=6}">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.rollInitiative(sheet) end</event>
                                </button>
                                <button align="left" width="115" text="Briga (Des+Bri)" fontSize="10" margins="{right=6}">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.rollFromSheet(sheet, {attrId='attr_destreza', habId='hab_briga', difficulty=6, label='Ataque de Briga'}) end</event>
                                </button>
                                <button align="left" width="125" text="Esquiva (Des+Esp)" fontSize="10" margins="{right=6}">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.rollFromSheet(sheet, {attrId='attr_destreza', habId='hab_esportes', difficulty=6, label='Esquiva'}) end</event>
                                </button>
                                <button align="left" width="135" text="Armas Brancas" fontSize="10" margins="{right=6}">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.rollFromSheet(sheet, {attrId='attr_destreza', habId='hab_armas_brancas', difficulty=6, label='Armas Brancas'}) end</event>
                                </button>
                                <button align="left" width="135" text="Armas de Fogo" fontSize="10">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.rollFromSheet(sheet, {attrId='attr_destreza', habId='hab_armas_fogo', difficulty=6, label='Armas de Fogo'}) end</event>
                                </button>
                            </layout>
                        </rectangle>

                        <rectangle name="crdEstudioManobras" align="top" height="236" color="#16161E" strokeColor="#C48F36" strokeSize="1" xradius="6" yradius="6" padding="{left=12, right=12, top=8, bottom=8}" margins="{bottom=10}">
                            <label name="lblTituloEstudioManobras" align="top" height="20" text="ESTÚDIO DE MANOBRAS V20, DIVISÃO DE PARADAS &amp; DANO ENCADEADO" fontColor="#C48F36" fontSize="11" fontStyle="bold" horzTextAlign="leading"/>
                            <layout align="top" height="28" margins="{top=4}">
                                <label align="left" width="58" text="Manobra:" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
                                <comboBox name="cmbCmbManobraId" align="left" width="245" field="cmb_manobra_id" items="{'Soco (Des+Briga, Dif 6)', 'Chute (Des+Briga, Dif 7, For+1)', 'Mordida Vampírica (Agarrão, Agrav.)', 'Garras (Des+Briga, For+1)', 'Agarrão / Clinch (For+Briga)', 'Segurar / Hold (For+Briga, s/ Dano)', 'Encontrão / Tackle (For+Briga, Dif 7)', 'Rasteira — Briga (Dif 7)', 'Desarmar — Briga (Dif 7)', 'Golpe com Arma Equipada (Slot)', 'Estacar Coração (Dif 9, Letal)', 'Desarmar com Arma (+1 Dif)', 'Rasteira com Arma (+1 Dif)', 'Tiro Único (Slot Arma de Fogo)', 'Tiro Duplo Rápido (+1d, +1 Dif)', 'Rajada Curta 3 Tiros (+2d, +1 Dif)', 'Rajada Completa (+10d, +2 Dif)', 'Defesa: Esquiva Ativa (Des+Esp)', 'Defesa: Bloqueio (Des+Briga)', 'Defesa: Aparar (Des+Arm. Brancas)'}" values="{'strike', 'kick', 'bite', 'claw', 'clinch', 'hold', 'tackle', 'sweep_brawl', 'disarm_brawl', 'weapon_strike', 'stake_heart', 'disarm_melee', 'sweep_melee', 'single_shot', 'double_tap', 'three_round_burst', 'full_auto', 'dodge', 'block', 'parry'}" fontColor="#ECE8E1" fontSize="10" margins="{right=6}"/>
                                <comboBox name="cmbCmbArmaSlot" align="left" width="110" field="cmb_arma_slot" items="{'Slot Arma #1', 'Slot Arma #2', 'Slot Arma #3', 'Slot Arma #4'}" values="{'1', '2', '3', '4'}" fontColor="#ECE8E1" fontSize="10" margins="{right=6}"/>
                                <label align="left" width="72" text="Pen. Armad.:" fontColor="#9E9890" fontSize="10" horzTextAlign="trailing" margins="{right=3}"/>
                                <edit name="edtArmaduraPenalidade" align="left" width="34" field="armadura_penalidade" type="number" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center" margins="{right=8}"/>
                                <checkBox name="chkCmbEmAgarrao" align="left" width="115" field="em_agarrao" text="Em Agarrão" fontColor="#D9B45B" fontSize="10" fontStyle="bold"/>
                            </layout>
                            <layout align="top" height="28" margins="{top=4}">
                                <label align="left" width="46" text="Ações:" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
                                <comboBox name="cmbCmbAcoesNormais" align="left" width="150" field="cmb_acoes_normais" items="{'1 Ação (Sem Divisão)', '2 Ações (-2 / -3)', '3 Ações (-3 / -4 / -5)', '4 Ações (-4..-7)', '5 Ações (-5..-9)'}" values="{'1', '2', '3', '4', '5'}" fontColor="#ECE8E1" fontSize="10" margins="{right=6}"/>
                                <comboBox name="cmbCmbAcaoOrdem" align="left" width="88" field="cmb_acao_ordem" items="{'1ª Ação', '2ª Ação', '3ª Ação', '4ª Ação', '5ª Ação'}" values="{'1', '2', '3', '4', '5'}" fontColor="#ECE8E1" fontSize="10" margins="{right=6}"/>
                                <label align="left" width="88" text="Menor Parada:" fontColor="#9E9890" fontSize="10" horzTextAlign="trailing" margins="{right=3}"/>
                                <edit name="edtCmbMenorParada" align="left" width="36" field="cmb_menor_parada" type="number" fontColor="#D9B45B" fontSize="11" horzTextAlign="center" margins="{right=8}"/>
                                <checkBox name="chkCmbAcaoRapidez" align="left" width="128" field="cmb_acao_rapidez" text="Ação de Rapidez" fontColor="#ECE8E1" fontSize="10" margins="{right=4}"/>
                                <label align="left" width="52" text="Extras:" fontColor="#9E9890" fontSize="10" horzTextAlign="trailing" margins="{right=3}"/>
                                <label name="lblCmbRapidezExtras" align="left" width="26" field="rapidez_acoes_extras" fontColor="#D9B45B" fontSize="11" fontStyle="bold" horzTextAlign="center"/>
                            </layout>
                            <layout align="top" height="28" margins="{top=4}">
                                <label align="left" width="36" text="Mira:" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
                                <edit name="edtCmbMiraTurnos" align="left" width="32" field="cmb_mira_turnos" type="number" fontColor="#D9B45B" fontSize="11" horzTextAlign="center" margins="{right=4}"/>
                                <checkBox name="chkCmbTemLuneta" align="left" width="68" field="cmb_tem_luneta" text="Luneta" fontColor="#ECE8E1" fontSize="10" margins="{right=6}"/>
                                <comboBox name="cmbCmbAlvoLocalizado" align="left" width="185" field="cmb_alvo_localizado" items="{'Sem Alvo Específico', 'Membro / Arma (+1 Dif)', 'Cabeça / Vital (+2 Dif, +1d)'}" values="{'nenhum', 'membro', 'cabeca'}" fontColor="#ECE8E1" fontSize="10" margins="{right=6}"/>
                                <comboBox name="cmbCmbCobertura" align="left" width="165" field="cmb_cobertura" items="{'Sem Cobertura', 'Cobertura Leve (+1 Dif)', 'Boa Cobertura (+2 Dif)', 'Cobertura Superior (+3 Dif)'}" values="{'nenhuma', 'leve', 'boa', 'superior'}" fontColor="#ECE8E1" fontSize="10" margins="{right=6}"/>
                                <comboBox name="cmbCmbPosicao" align="client" field="cmb_posicao" items="{'Frontal (+0 Dif)', 'Flanco (-1 Dif)', 'Retaguarda (-2 Dif)'}" values="{'frontal', 'flanco', 'retaguarda'}" fontColor="#ECE8E1" fontSize="10"/>
                            </layout>
                            <layout align="top" height="28" margins="{top=4}">
                                <label align="left" width="84" text="Sucessos Def.:" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
                                <edit name="edtCmbDefesaAlvo" align="left" width="34" field="cmb_defesa_alvo_sucessos" type="number" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center" margins="{right=8}"/>
                                <label align="left" width="68" text="Força Alvo:" fontColor="#9E9890" fontSize="10" horzTextAlign="trailing" margins="{right=3}"/>
                                <edit name="edtCmbForcaAlvo" align="left" width="34" field="cmb_forca_alvo" type="number" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center" margins="{right=8}"/>
                                <label align="left" width="92" text="Defesas Turno:" fontColor="#9E9890" fontSize="10" horzTextAlign="trailing" margins="{right=3}"/>
                                <edit name="edtCmbDefesasTurno" align="left" width="34" field="cmb_defesas_feitas_turno" type="number" fontColor="#D9B45B" fontSize="11" horzTextAlign="center" margins="{right=8}"/>
                                <button name="btnCmbExecutarManobra" align="right" width="175" text="Executar Manobra V20" fontSize="11" fontStyle="bold">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.executeCombatManeuver(sheet, nil) end</event>
                                </button>
                            </layout>
                            <label name="lblCmbManobraResumo" align="top" height="20" field="cmb_manobra_resumo" fontColor="#9E9890" fontSize="10" horzTextAlign="leading" margins="{top=4}"/>
                            <layout align="top" height="30" margins="{top=4}">
                                <label align="left" width="98" text="Dano Encadeado:" fontColor="#D9B45B" fontSize="10" fontStyle="bold" horzTextAlign="leading"/>
                                <label name="lblCmbDanoPendenteResumo" align="client" field="cmb_dano_pendente_resumo" fontColor="#ECE8E1" fontSize="10" horzTextAlign="leading" margins="{right=8}"/>
                                <button name="btnCmbRolarDanoPendente" align="right" width="175" text="Rolar Dano Encadeado" fontSize="11" fontStyle="bold">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.rollPendingCombatDamage(sheet) end</event>
                                </button>
                            </layout>
                        </rectangle>

                        <rectangle align="top" height="170" color="#16161E" strokeColor="#24303E" strokeSize="1" xradius="6" yradius="6" padding="{left=12, right=12, top=8, bottom=8}" margins="{bottom=10}">
                            <label align="top" height="22" text="ARMAMENTO &amp; MANOBRAS EQUIPADAS (NOME • ATRIB • HAB • DIF • DANO • TIPO • MUNIÇÃO)" fontColor="#C48F36" fontSize="11" fontStyle="bold" horzTextAlign="leading"/>
                            <layout align="top" height="28" margins="{bottom=3}">
                                <edit align="left" width="155" field="arma1_nome" textPrompt="Arma / Manobra #1" fontColor="#ECE8E1" fontSize="11" margins="{right=6}"/>
                                <comboBox align="left" width="115" field="arma1_attr" items="{'Força', 'Destreza', 'Vigor', 'Carisma', 'Manipulação', 'Aparência', 'Percepção', 'Inteligência', 'Raciocínio'}" values="{'attr_forca', 'attr_destreza', 'attr_vigor', 'attr_carisma', 'attr_manipulacao', 'attr_aparencia', 'attr_percepcao', 'attr_inteligencia', 'attr_raciocinio'}" fontColor="#ECE8E1" fontSize="10" margins="{right=4}"/>
