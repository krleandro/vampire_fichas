                <rectangle align="top" height="340" color="#16161E" strokeColor="#24303E" strokeSize="1" xradius="6" yradius="6" padding="{left=12, right=12, top=10, bottom=10}" margins="{bottom=10}">
                    <label align="top" height="22" text="VITALIDADE, ABSORÇÃO E APLICADOR ASSISTIDO DE DANO (V20)" fontColor="#C48F36" fontSize="12" fontStyle="bold" horzTextAlign="leading"/>
                    <layout align="top" height="26" margins="{top=4}">
                        <label align="left" width="80" text="Contundente:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                        <edit align="left" width="38" field="dano_contundente" type="number" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center" margins="{right=10}"/>
                        <label align="left" width="42" text="Letal:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                        <edit align="left" width="38" field="dano_letal" type="number" fontColor="#D9B45B" fontSize="11" horzTextAlign="center" margins="{right=10}"/>
                        <label align="left" width="66" text="Agravado:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                        <edit align="left" width="38" field="dano_aggravado" type="number" fontColor="#E05A5A" fontSize="11" horzTextAlign="center" margins="{right=12}"/>
                        <label align="left" width="66" text="Armadura:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                        <edit align="left" width="38" field="armadura_absorcao" type="number" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center" margins="{right=8}"/>
                        <checkBox name="chkTamanhoGrande" align="left" width="130" field="tem_tamanho_grande" text="Tamanho Grande (+1)" fontColor="#ECE8E1" fontSize="10"/>
                    </layout>
                    <layout align="top" height="28" margins="{top=4}">
                        <label align="left" width="36" text="Qtd:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                        <edit align="left" width="38" field="dano_aplicar_qtd" type="number" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center" margins="{right=6}"/>
                        <comboBox align="left" width="140" field="dano_aplicar_tipo" items="{'Contundente (/)', 'Letal (X)', 'Agravado (*)'}" values="{'bashing', 'lethal', 'aggravated'}" fontColor="#ECE8E1" fontSize="11" margins="{right=8}"/>
                        <button align="left" width="106" text="Aplicar Dano" fontSize="11" fontStyle="bold" margins="{right=10}">
                            <event name="onClick">if sheet ~= nil then V20Bridge.applyDamage(sheet, nil, nil) end</event>
                        </button>
                        <comboBox align="left" width="135" field="cura_tipo" items="{'Contundente (/)', 'Letal (X)', 'Agravado (*)'}" values="{'bashing', 'lethal', 'aggravated'}" fontColor="#ECE8E1" fontSize="11" margins="{right=6}"/>
                        <button align="left" width="112" text="Curar c/ Vitae" fontSize="11" margins="{right=8}">
                            <event name="onClick">if sheet ~= nil then V20Bridge.healDamage(sheet, nil) end</event>
                        </button>
                        <button align="left" width="118" text="Rolar Absorção" fontSize="11">
                            <event name="onClick">if sheet ~= nil then V20Bridge.rollSoak(sheet, sheet.dano_aplicar_tipo) end</event>
                        </button>
                    </layout>
                    <layout align="top" height="24" margins="{top=4, bottom=4}">
                        <label align="left" width="320" text="Regra Mortal: Armas de Fogo causam dano Letal; Absorção Letal exige Armadura." fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
                    </layout>
                    <layout align="top" height="22"><label align="left" width="190" text="0. Escoriado Extra (Tam. Grande)" fontColor="#ECE8E1" fontSize="11" horzTextAlign="leading"/><label align="left" width="54" field="health_box_0" fontColor="#D9B45B" fontSize="12" fontStyle="bold" horzTextAlign="center"/></layout>
                    <layout align="top" height="22"><label align="left" width="190" text="1. Escoriado (0)" fontColor="#ECE8E1" fontSize="11" horzTextAlign="leading"/><label align="left" width="54" field="health_box_1" fontColor="#D9B45B" fontSize="12" fontStyle="bold" horzTextAlign="center"/></layout>
                    <layout align="top" height="22"><label align="left" width="190" text="2. Machucado (-1)" fontColor="#ECE8E1" fontSize="11" horzTextAlign="leading"/><label align="left" width="54" field="health_box_2" fontColor="#D9B45B" fontSize="12" fontStyle="bold" horzTextAlign="center"/></layout>
                    <layout align="top" height="22"><label align="left" width="190" text="3. Ferido (-1)" fontColor="#ECE8E1" fontSize="11" horzTextAlign="leading"/><label align="left" width="54" field="health_box_3" fontColor="#D9B45B" fontSize="12" fontStyle="bold" horzTextAlign="center"/></layout>
                    <layout align="top" height="22"><label align="left" width="190" text="4. Ferido Gravemente (-2)" fontColor="#ECE8E1" fontSize="11" horzTextAlign="leading"/><label align="left" width="54" field="health_box_4" fontColor="#D9B45B" fontSize="12" fontStyle="bold" horzTextAlign="center"/></layout>
                    <layout align="top" height="22"><label align="left" width="190" text="5. Espancado (-2)" fontColor="#ECE8E1" fontSize="11" horzTextAlign="leading"/><label align="left" width="54" field="health_box_5" fontColor="#D9B45B" fontSize="12" fontStyle="bold" horzTextAlign="center"/></layout>
                    <layout align="top" height="22"><label align="left" width="190" text="6. Aleijado (-5)" fontColor="#ECE8E1" fontSize="11" horzTextAlign="leading"/><label align="left" width="54" field="health_box_6" fontColor="#D9B45B" fontSize="12" fontStyle="bold" horzTextAlign="center"/></layout>
                    <layout align="top" height="22"><label align="left" width="190" text="7. Incapacitado (Imóvel)" fontColor="#ECE8E1" fontSize="11" horzTextAlign="leading"/><label align="left" width="54" field="health_box_7" fontColor="#D9B45B" fontSize="12" fontStyle="bold" horzTextAlign="center"/></layout>
                </rectangle>
                    </layout>
                </scrollBox>
            </tab>
            <tab name="tabMoralidade" title="6. Moralidade &amp; Psique">
                <scrollBox align="client" padding="{left=10, right=10, top=10, bottom=10}">
                    <layout align="top" height="420">
                        <rectangle align="top" height="175" color="#16161E" strokeColor="#24303E" strokeSize="1" xradius="6" yradius="6" padding="{left=12, right=12, top=10, bottom=10}" margins="{bottom=10}">
                            <label align="top" height="22" text="VIRTUDES HUMANAS, HUMANIDADE &amp; FORÇA DE VONTADE" fontColor="#C48F36" fontSize="12" fontStyle="bold" horzTextAlign="leading"/>
                            <layout align="top" height="28" margins="{top=6}">
                                <label align="left" width="95" text="Consciência:" fontColor="#ECE8E1" fontSize="11" horzTextAlign="leading"/>
                                <edit name="edtVirtude1Val" align="left" width="40" field="virtude1_val" type="number" fontColor="#D9B45B" fontSize="11" fontStyle="bold" horzTextAlign="center" margins="{right=16}"/>
                                <label align="left" width="95" text="Autocontrole:" fontColor="#ECE8E1" fontSize="11" horzTextAlign="leading"/>
                                <edit name="edtVirtude2Val" align="left" width="40" field="virtude2_val" type="number" fontColor="#D9B45B" fontSize="11" fontStyle="bold" horzTextAlign="center" margins="{right=16}"/>
                                <label align="left" width="75" text="Coragem:" fontColor="#ECE8E1" fontSize="11" horzTextAlign="leading"/>
                                <edit name="edtVirtude3Val" align="left" width="40" field="virtude3_val" type="number" fontColor="#D9B45B" fontSize="11" fontStyle="bold" horzTextAlign="center"/>
                            </layout>
                            <layout align="top" height="28" margins="{top=8}">
                                <label align="left" width="95" text="Humanidade:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <edit name="edtMoralidadeVal" align="left" width="42" field="moralidade_val" type="number" fontColor="#D9B45B" fontSize="12" fontStyle="bold" horzTextAlign="center" margins="{right=14}"/>
                                <label align="left" width="95" text="FdV Perm.:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <edit name="edtFdvPerm" align="left" width="42" field="fdv_perm" type="number" fontColor="#D9B45B" fontSize="11" fontStyle="bold" horzTextAlign="center" margins="{right=14}"/>
                                <label align="left" width="44" text="Aura:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <label align="client" field="aura_resumo" fontColor="#D9B45B" fontSize="11" fontStyle="bold" horzTextAlign="leading"/>
                            </layout>
                            <layout align="top" height="32" margins="{top=10}">
                                <button align="left" width="225" text="Testar Degeneração (Consciência Dif 8)" fontSize="11" margins="{right=10}">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.rollDegeneration(sheet) end</event>
                                </button>
                                <button align="left" width="185" text="Testar Coragem / Pânico" fontSize="11" margins="{right=10}">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.rollRotschreck(sheet, 6) end</event>
                                </button>
                                <button name="btnFrenesiCarnical" visible="false" align="left" width="185" text="Frenesi Carniçal" fontSize="11">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.rollFrenzy(sheet, 6) end</event>
                                </button>
                            </layout>
                        </rectangle>
                    </layout>
                </scrollBox>
            </tab>
            <tab name="tabExperiencia" title="7. Experiência &amp; Narrador">
                <scrollBox align="client" padding="{left=10, right=10, top=10, bottom=10}">
                    <layout align="top" height="760">
                        <rectangle align="top" height="84" color="#16161E" strokeColor="#C48F36" strokeSize="1" xradius="6" yradius="6" padding="{left=12, right=12, top=8, bottom=8}" margins="{bottom=10}">
                            <label align="top" height="22" text="CHAVE DO NARRADOR — TRANSIÇÃO SOBRENATURAL EM JOGO (HUMANO | CARNIÇAL | NUMINA)" fontColor="#C48F36" fontSize="11" fontStyle="bold" horzTextAlign="leading"/>
                            <layout align="top" height="30" margins="{top=4}">
                                <label align="left" width="140" text="Condição Sobrenatural:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <comboBox name="cmbMortalSobrenaturalModo" align="left" width="390" field="mortal_sobrenatural_modo" items="{'Humano Puro (Padrão)', 'Carniçal / Ghoul (Vitae máx 2 + Potência 1)', 'Numina (Fé Verdadeira / Magia de Cerca / Psíquico)'}" values="{'humano', 'carnical', 'numina'}" fontColor="#D9B45B" fontSize="11" margins="{right=12}"/>
                                <label align="left" width="110" text="Teto Disc. Ghoul:" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
                                <edit name="edtCarnicalDiscMax" align="left" width="38" field="carnical_disc_max" type="number" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center"/>
                            </layout>
                        </rectangle>
                        <rectangle align="top" height="190" color="#16161E" strokeColor="#24303E" strokeSize="1" xradius="6" yradius="6" padding="{left=12, right=12, top=10, bottom=10}" margins="{bottom=10}">
                            <label align="top" height="22" text="EVOLUÇÃO POR EXPERIÊNCIA (XP) &amp; FILA DE APROVAÇÃO DO NARRADOR" fontColor="#C48F36" fontSize="12" fontStyle="bold" horzTextAlign="leading"/>
                            <layout align="top" height="28" margins="{top=4}">
                                <label align="left" width="68" text="XP Total:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <edit name="edtXpTotal" align="left" width="48" field="xp_total" type="number" fontColor="#D9B45B" fontSize="11" fontStyle="bold" horzTextAlign="center" margins="{right=10}"/>
                                <label align="left" width="68" text="XP Gasto:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <edit name="edtXpGasto" align="left" width="48" field="xp_gasto" type="number" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center" margins="{right=10}"/>
                                <label align="left" width="95" text="XP Disponível:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <label align="left" width="48" field="xp_disponivel" fontColor="#D9B45B" fontSize="12" fontStyle="bold" horzTextAlign="center" margins="{right=14}"/>
                                <checkBox name="chkXpExigeAprovacao" align="left" width="185" field="xp_exige_aprovacao" text="Exigir Aprovação Mestre" fontColor="#ECE8E1" fontSize="10"/>
                                <checkBox name="chkNarradorOverride" align="left" width="165" field="narrador_override" text="Override do Narrador" fontColor="#E05A5A" fontSize="10"/>
                            </layout>
                            <layout align="top" height="28" margins="{top=6}">
                                <comboBox name="cmbXpLojaTipo" align="left" width="195" field="xp_loja_tipo" items="{'Automático (pelo Campo)', 'Atributo (Atual x4)', 'Habilidade (Nova 3 / Atual x2)', 'Disciplina (Nova 10 / Clã x5 / Fora x7)', 'Linha Secundária (Nova 7 / Atual x4)', 'Virtude (Atual x2)', 'Moralidade (Atual x2)', 'Força de Vontade (Atual x1)'}" values="{'auto', 'attribute', 'ability', 'discipline', 'secondary_path', 'virtue', 'morality', 'willpower'}" fontColor="#ECE8E1" fontSize="10" margins="{right=6}"/>
                                <comboBox name="cmbXpLojaCampo" align="left" width="175" field="xp_loja_campo" items="{'Atributo: Força', 'Atributo: Destreza', 'Atributo: Vigor', 'Atributo: Carisma', 'Atributo: Manipulação', 'Atributo: Aparência', 'Atributo: Percepção', 'Atributo: Inteligência', 'Atributo: Raciocínio', 'Habilidade: Prontidão', 'Habilidade: Esportes', 'Habilidade: Consciência', 'Habilidade: Briga', 'Habilidade: Empatia', 'Habilidade: Expressão', 'Habilidade: Intimidação', 'Habilidade: Liderança', 'Habilidade: Manha', 'Habilidade: Lábia', 'Habilidade: Empatia c/ Animais', 'Habilidade: Ofícios', 'Habilidade: Condução', 'Habilidade: Etiqueta', 'Habilidade: Armas de Fogo', 'Habilidade: Arrombamento', 'Habilidade: Armas Brancas', 'Habilidade: Performance', 'Habilidade: Furtividade', 'Habilidade: Sobrevivência', 'Habilidade: Acadêmicos', 'Habilidade: Computador', 'Habilidade: Finanças', 'Habilidade: Investigação', 'Habilidade: Direito', 'Habilidade: Medicina', 'Habilidade: Ocultismo', 'Habilidade: Política', 'Habilidade: Ciências', 'Habilidade: Tecnologia', 'Hab. Secundária #1', 'Hab. Secundária #2', 'Hab. Secundária #3', 'Hab. Secundária #4', 'Disciplina Slot #1', 'Disciplina Slot #2', 'Disciplina Slot #3', 'Disciplina Slot #4', 'Disciplina Slot #5', 'Disciplina Slot #6', 'Disciplina Slot #7', 'Disciplina Slot #8', 'Disciplina Slot #9', 'Virtude 1 (Consciência/Convicção)', 'Virtude 2 (Autocontrole/Instinto)', 'Virtude 3 (Coragem)', 'Moralidade / Humanidade / Trilha', 'Força de Vontade Permanente'}" values="{'attr_forca', 'attr_destreza', 'attr_vigor', 'attr_carisma', 'attr_manipulacao', 'attr_aparencia', 'attr_percepcao', 'attr_inteligencia', 'attr_raciocinio', 'hab_prontidao', 'hab_esportes', 'hab_consciencia', 'hab_briga', 'hab_empatia', 'hab_expressao', 'hab_intimidacao', 'hab_lideranca', 'hab_manha', 'hab_labia', 'hab_empatia_animais', 'hab_oficios', 'hab_conducao', 'hab_etiqueta', 'hab_armas_fogo', 'hab_arrombamento', 'hab_armas_brancas', 'hab_performance', 'hab_furtividade', 'hab_sobrevivencia', 'hab_academicos', 'hab_computador', 'hab_financas', 'hab_investigacao', 'hab_direito', 'hab_medicina', 'hab_ocultismo', 'hab_politica', 'hab_ciencias', 'hab_tecnologia', 'hab_extra1_val', 'hab_extra2_val', 'hab_extra3_val', 'hab_extra4_val', 'disc_slot1_nivel', 'disc_slot2_nivel', 'disc_slot3_nivel', 'disc_slot4_nivel', 'disc_slot5_nivel', 'disc_slot6_nivel', 'disc_slot7_nivel', 'disc_slot8_nivel', 'disc_slot9_nivel', 'virtude1_val', 'virtude2_val', 'virtude3_val', 'moralidade_val', 'fdv_perm'}" fontColor="#ECE8E1" fontSize="10" margins="{right=6}"/>
                                <comboBox name="cmbXpLojaCatCusto" align="left" width="140" field="xp_loja_cat_custo" items="{'Automático (pela Ficha)', 'De Clã (x5)', 'Caitiff (x6)', 'Fora do Clã (x7)'}" values="{'auto', 'cla', 'caitiff', 'fora_cla'}" fontColor="#ECE8E1" fontSize="10" margins="{right=6}"/>
                                <edit name="edtXpLojaDescricao" align="client" field="xp_loja_descricao" textPrompt="Rótulo p/ Auditoria" fontColor="#9E9890" fontSize="10" margins="{right=6}"/>
                                <button name="btnSolicitarXP" align="right" width="135" text="Solicitar Evolução" fontSize="10" fontStyle="bold">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.submitOrApproveXP(sheet, 'submit', nil) end</event>
                                </button>
                            </layout>
                            <layout align="top" height="30" margins="{top=8}">
                                <label align="left" width="75" text="Pendente:" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
                                <label align="left" width="85" field="xp_pendente_status" fontColor="#D9B45B" fontSize="11" fontStyle="bold" horzTextAlign="leading"/>
                                <label align="client" field="xp_pendente_desc" fontColor="#ECE8E1" fontSize="10" horzTextAlign="leading"/>
                                <button name="btnRecusarXP" align="right" width="115" text="Recusar (Mestre)" fontSize="10" margins="{left=6}">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.submitOrApproveXP(sheet, 'reject', nil) end</event>
                                </button>
                                <button name="btnAprovarXP" align="right" width="115" text="Aprovar (Mestre)" fontSize="10" fontStyle="bold">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.submitOrApproveXP(sheet, 'approve', nil) end</event>
                                </button>
                            </layout>
                        </rectangle>

                        <rectangle align="top" height="230" color="#16161E" strokeColor="#24303E" strokeSize="1" xradius="6" yradius="6" padding="{left=12, right=12, top=10, bottom=10}" margins="{bottom=10}">
                            <label align="top" height="22" text="HISTÓRICO AUDITÁVEL IMUTÁVEL DE XP E ALTERAÇÕES DO NARRADOR" fontColor="#C48F36" fontSize="11" fontStyle="bold" horzTextAlign="leading"/>
                            <textEditor align="client" field="auditoria_xp_log" readOnly="true" fontColor="#ECE8E1" fontSize="11" margins="{top=4}"/>
                        </rectangle>

                        <rectangle align="top" height="170" color="#16161E" strokeColor="#24303E" strokeSize="1" xradius="6" yradius="6" padding="{left=12, right=12, top=10, bottom=10}">
                            <label align="top" height="22" text="DIÁRIO DA CRÔNICA, LAÇOS DE SANGUE &amp; ANOTAÇÕES" fontColor="#C48F36" fontSize="11" fontStyle="bold" horzTextAlign="leading"/>
                            <textEditor align="client" field="notas_cronica" fontColor="#ECE8E1" fontSize="11" margins="{top=4}"/>
                        </rectangle>
                    </layout>
                </scrollBox>
            </tab>
        </tabControl>
    </rectangle>

    <dataLink fields="{'nome', 'is_vampire', 'modo_ficha', 'mortal_perfil', 'mortal_sobrenatural_modo', 'carnical_disc_max', 'sangue_atual', 'sangue_max', 'sangue_por_turno', 'sangue_gasto_turno', 'fdv_perm', 'fdv_temp', 'virtude1_tipo', 'virtude1_val', 'virtude2_tipo', 'virtude2_val', 'virtude3_val', 'moralidade_tipo', 'moralidade_nome', 'moralidade_val', 'dano_contundente', 'dano_letal', 'dano_aggravado', 'dano_aplicar_qtd', 'dano_aplicar_tipo', 'cura_tipo', 'armadura_absorcao', 'tem_tamanho_grande', 'roll_attr_id', 'roll_hab_id', 'roll_bonus_dice', 'roll_diff'}" defaultValues="{'Mortal V20', 'false', 'criacao', 'padrao_643', 'humano', '1', '0', '0', '0', '0', '5', '5', 'consciencia', '3', 'autocontrole', '3', '3', 'humanidade', 'Humanidade', '7', '0', '0', '0', '1', 'bashing', 'bashing', '0', 'false', 'attr_percepcao', 'hab_investigacao', '0', '6'}"><event name="onChange">if sheet ~= nil and V20Bridge ~= nil then V20Bridge.syncDerivedFields(sheet); atualizarVisibilidadeMortal(self); atualizarPermissoesModo(self); end</event></dataLink>
    <dataLink fields="{'roll_usar_espec', 'roll_gastar_fdv', 'roll_usar_fama', 'roll_usar_status', 'roll_ignorar_ferimento', 'xp_total', 'xp_gasto', 'xp_exige_aprovacao', 'narrador_override', 'xp_loja_tipo', 'xp_loja_campo', 'xp_loja_cat_custo', 'xp_pendente_status', 'disc_slot1_id', 'disc_slot1_nivel', 'disc_slot1_pwr_lvl', 'disc_slot2_id', 'disc_slot2_nivel', 'disc_slot2_pwr_lvl', 'disc_slot3_id', 'disc_slot3_nivel', 'disc_slot3_pwr_lvl', 'disc_slot4_id', 'disc_slot4_nivel', 'disc_slot4_pwr_lvl', 'numina_true_faith', 'numina_hedge_magic', 'numina_psychic', 'attr_forca', 'attr_destreza', 'attr_vigor', 'attr_carisma'}" defaultValues="{'false', 'false', 'false', 'false', 'false', '0', '0', 'true', 'false', 'auto', 'hab_investigacao', 'auto', 'nenhum', 'potence', '0', '1', '', '0', '1', '', '0', '1', '', '0', '1', '0', '0', '0', '1', '1', '1', '1'}"><event name="onChange">if sheet ~= nil and V20Bridge ~= nil then V20Bridge.syncDerivedFields(sheet); atualizarVisibilidadeMortal(self); atualizarPermissoesModo(self); end</event></dataLink>
