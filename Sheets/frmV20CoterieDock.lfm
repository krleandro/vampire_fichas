            <tab name="tabSobreSuite" title="Sobre">
                <scrollBox align="client" padding="{left=10, right=10, top=10, bottom=10}">
                    <layout align="top" height="420">
                        <rectangle name="crdSobreIdentificacao" align="top" height="156" color="#16161E" strokeColor="#9E1B24" strokeSize="1" xradius="6" yradius="6" padding="{left=8, right=8, top=14, bottom=14}" margins="{bottom=10}">
                            <label name="lblSobreSelo" align="top" height="20" text="IDENTIFICAÇÃO DA SUÍTE • RRPG FIRECAST SDK 3.7b" fontColor="#9E9890" fontSize="10" fontStyle="bold" horzTextAlign="center"/>
                            <label name="lblSobreTituloPrincipal" align="top" height="44" text="Suite de plugins para Vampiro - A máscara V 20" wordWrap="true" fontColor="#D9B45B" fontSize="13" fontStyle="bold" horzTextAlign="center" margins="{top=6}"/>
                            <label name="lblSobreAutoria" align="top" height="30" text="Desenvolvida por Mestre Carlos (krmirim)" wordWrap="true" fontColor="#9E1B24" fontSize="12" fontStyle="bold" horzTextAlign="center" margins="{top=4}"/>
                            <label name="lblSobreVersaoModelo" align="top" height="28" text="Versão 1.0.1 • Painel Coterie &amp; Iniciativa (br.com.v20.CoterieDock)" wordWrap="true" fontColor="#ECE8E1" fontSize="10" horzTextAlign="center" margins="{top=6}"/>
                        </rectangle>

                        <rectangle name="crdSobreModulos" align="top" height="230" color="#16161E" strokeColor="#3A1C24" strokeSize="1" xradius="6" yradius="6" padding="{left=8, right=8, top=12, bottom=12}">
                            <label name="lblSobreEscopoTitulo" align="top" height="22" text="ECOSSISTEMA INTEGRADO V20 (16 FORMULÁRIOS)" fontColor="#9E1B24" fontSize="11" fontStyle="bold" horzTextAlign="leading"/>
                            <label name="lblSobreItem1" align="top" height="36" text="• 15 Modelos de Ficha dedicados: 13 Clãs Tradicionais, Caitiff e Ficha Mortal (Humano, Carniçal e Numina)." wordWrap="true" fontColor="#ECE8E1" fontSize="10" horzTextAlign="leading" margins="{top=6}"/>
                            <label name="lblSobreItem2" align="top" height="36" text="• Painel acoplável TablesDock da Coterie &amp; Iniciativa V20 sincronizado na sala com proteção anti-metajogo." wordWrap="true" fontColor="#ECE8E1" fontSize="10" horzTextAlign="leading" margins="{top=4}"/>
                            <label name="lblSobreItem3" align="top" height="42" text="• Automação universal de 17 Disciplinas, 9 Linhas e 20 Rituais de Magia do Sangue, 14 Fraquezas, 20 Manobras de Combate Assistido, Gerações 4ª–15ª e Auditoria de XP." wordWrap="true" fontColor="#ECE8E1" fontSize="10" horzTextAlign="leading" margins="{top=4}"/>
                            <label name="lblSobreReferencia" align="top" height="26" text="Referência mecânica: Vampire: The Masquerade — 20th Anniversary Edition (V20)." wordWrap="true" fontColor="#9E9890" fontSize="10" horzTextAlign="leading" margins="{top=8}"/>
                        </rectangle>
                    </layout>
                </scrollBox>
            </tab>
        </tabControl>
    </rectangle>

    <dataLink fields="{'npc_init_nome', 'npc_init_mod', 'npc_init_oculto'}" defaultValues="{'NPC', '4', 'false'}"></dataLink>
    <event name="OnNodeReady">if CoterieDockBridge ~= nil and CoterieDockBridge.ensureIsolatedSheet ~= nil then CoterieDockBridge.ensureIsolatedSheet(self) end</event>
    <event name="OnShow">if CoterieDockBridge ~= nil then CoterieDockBridge.connectDock(self) end</event>
    <event name="OnHide">if CoterieDockBridge ~= nil then CoterieDockBridge.disconnectDock(self) end</event>
</form>
