<?xml version="1.0" encoding="UTF-8"?>
<form name="frmBrujah" formType="sheetTemplate" dataType="br.com.v20.Brujah" title="Vampiro V20 - Brujah" align="client" theme="dark">

    <script>
        <![CDATA[
        local V20Bridge = _G.V20Bridge or require("Adapter.firecast_bridge")
        ]]>
    </script>

    <rectangle align="client" color="#0D0D11">
        <rectangle name="barHeaderTop" align="top" height="74" color="#16161E" strokeColor="#9E1B24" strokeSize="1" padding="{left=12, right=12, top=6, bottom=6}">
            <layout align="top" height="28">
                <label align="left" width="175" text="CLÃ BRUJAH (V20)" fontColor="#9E1B24" fontSize="13" fontStyle="bold" horzTextAlign="leading"/>
                <label align="left" width="48" text="Nome:" fontColor="#9E9890" fontSize="11" horzTextAlign="trailing" margins="{right=4}"/>
                <edit align="left" width="210" field="nome" textPrompt="Nome do Personagem" fontColor="#ECE8E1" fontSize="12" fontStyle="bold"/>
                <label align="left" width="64" text="Geração:" fontColor="#9E9890" fontSize="11" horzTextAlign="trailing" margins="{right=4}"/><label align="left" width="32" field="geracao" fontColor="#D9B45B" fontSize="13" fontStyle="bold" horzTextAlign="center"/>
                <label align="left" width="70" text="Vitalidade:" fontColor="#9E9890" fontSize="11" horzTextAlign="trailing" margins="{left=8, right=4}"/>
                <label align="left" width="120" field="vitalidade_resumo" fontColor="#ECE8E1" fontSize="11" fontStyle="bold" horzTextAlign="leading"/>
                <label align="client" field="vitalidade_alerta" fontColor="#E05A5A" fontSize="11" fontStyle="bold" horzTextAlign="leading"/>
            </layout>
            <layout align="top" height="30" margins="{top=4}">
                <layout name="pnlHeaderBlood" align="left" width="320" visible="true">
                    <label align="left" width="54" text="Sangue:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                    <button align="left" width="24" text="-" fontSize="12" fontStyle="bold">
                        <event name="onClick">if sheet ~= nil then V20Bridge.adjustResource(sheet, 'sangue_atual', -1, 0, 'sangue_max') end</event>
                    </button>
                    <label align="left" width="32" field="sangue_atual" fontColor="#E05A5A" fontSize="12" fontStyle="bold" horzTextAlign="center"/>
                    <label align="left" width="12" text="/" fontColor="#9E9890" fontSize="11" horzTextAlign="center"/>
                    <label align="left" width="28" field="sangue_max" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center"/>
                    <button align="left" width="24" text="+" fontSize="12" fontStyle="bold" margins="{right=8}">
                        <event name="onClick">if sheet ~= nil then V20Bridge.adjustResource(sheet, 'sangue_atual', 1, 0, 'sangue_max') end</event>
                    </button>
                    <label align="left" width="46" text="Turno:" fontColor="#9E9890" fontSize="10" horzTextAlign="trailing"/>
                    <label align="left" width="22" field="sangue_gasto_turno" fontColor="#D9B45B" fontSize="11" horzTextAlign="center"/>
                    <label align="left" width="10" text="/" fontColor="#9E9890" fontSize="10" horzTextAlign="center"/>
                    <label align="left" width="24" field="sangue_por_turno" fontColor="#9E9890" fontSize="11" horzTextAlign="center"/>
                </layout>
                <layout align="left" width="215">
                    <label align="left" width="66" text="FdV Temp:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                    <button align="left" width="24" text="-" fontSize="12" fontStyle="bold">
                        <event name="onClick">if sheet ~= nil then V20Bridge.adjustResource(sheet, 'fdv_temp', -1, 0, 'fdv_perm') end</event>
                    </button>
                    <label align="left" width="28" field="fdv_temp" fontColor="#D9B45B" fontSize="12" fontStyle="bold" horzTextAlign="center"/>
                    <label align="left" width="12" text="/" fontColor="#9E9890" fontSize="11" horzTextAlign="center"/>
                    <label align="left" width="28" field="fdv_perm" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center"/>
                    <button align="left" width="24" text="+" fontSize="12" fontStyle="bold">
                        <event name="onClick">if sheet ~= nil then V20Bridge.adjustResource(sheet, 'fdv_temp', 1, 0, 'fdv_perm') end</event>
                    </button>
                </layout>
                <button align="right" width="94" text="Novo Turno" fontSize="11" margins="{left=4}">
                    <event name="onClick">if sheet ~= nil then V20Bridge.newTurn(sheet) end</event>
                </button>
                <button align="right" width="76" text="Curar" fontSize="11" margins="{left=4}">
                    <event name="onClick">if sheet ~= nil then V20Bridge.healDamage(sheet, 'bashing') end</event>
                </button>
                <button align="right" width="88" text="Despertar" fontSize="11" fontStyle="bold" margins="{left=4}"><event name="onClick">if sheet ~= nil then V20Bridge.awakenNightly(sheet) end</event></button>
            </layout>
        </rectangle>
        <rectangle name="barFooterRoller" align="bottom" height="76" color="#16161E" strokeColor="#3A1C24" strokeSize="1" padding="{left=12, right=12, top=6, bottom=6}">
            <layout align="top" height="30">
                <label align="left" width="58" text="Atributo:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                <comboBox align="left" width="145" field="roll_attr_id" items="{'Força', 'Destreza', 'Vigor', 'Carisma', 'Manipulação', 'Aparência', 'Percepção', 'Inteligência', 'Raciocínio', 'Força de Vontade (Poder)', 'Coragem (Virtude)'}" values="{'attr_forca', 'attr_destreza', 'attr_vigor', 'attr_carisma', 'attr_manipulacao', 'attr_aparencia', 'attr_percepcao', 'attr_inteligencia', 'attr_raciocinio', 'attr_fdv_ref', 'hab_coragem_ref'}" fontColor="#ECE8E1" fontSize="11" margins="{right=8}"/>
                <label align="left" width="68" text="Habilidade:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                <comboBox align="left" width="175" field="roll_hab_id" items="{'— Apenas Atributo —', 'Prontidão', 'Esportes', 'Consciência', 'Briga', 'Empatia', 'Expressão', 'Intimidação', 'Liderança', 'Manha', 'Lábia', 'Empatia c/ Animais', 'Ofícios', 'Condução', 'Etiqueta', 'Armas de Fogo', 'Arrombamento', 'Armas Brancas', 'Performance', 'Furtividade', 'Sobrevivência', 'Acadêmicos', 'Computador', 'Finanças', 'Investigação', 'Direito', 'Medicina', 'Ocultismo', 'Política', 'Ciências', 'Tecnologia', 'Antecedente: Aliados', 'Antecedente: Identidade Alternativa', 'Antecedente: Contatos', 'Antecedente: Domínio', 'Antecedente: Fama', 'Antecedente: Geração', 'Antecedente: Rebanho', 'Antecedente: Influência', 'Antecedente: Mentor', 'Antecedente: Recursos', 'Antecedente: Lacaios', 'Antecedente: Rituais', 'Antecedente: Status', 'Autocontrole/Instinto', 'Coragem'}" values="{'none', 'hab_prontidao', 'hab_esportes', 'hab_consciencia', 'hab_briga', 'hab_empatia', 'hab_expressao', 'hab_intimidacao', 'hab_lideranca', 'hab_manha', 'hab_labia', 'hab_empatia_animais', 'hab_oficios', 'hab_conducao', 'hab_etiqueta', 'hab_armas_fogo', 'hab_arrombamento', 'hab_armas_brancas', 'hab_performance', 'hab_furtividade', 'hab_sobrevivencia', 'hab_academicos', 'hab_computador', 'hab_financas', 'hab_investigacao', 'hab_direito', 'hab_medicina', 'hab_ocultismo', 'hab_politica', 'hab_ciencias', 'hab_tecnologia', 'bg_allies', 'bg_alternate_identity', 'bg_contacts', 'bg_domain', 'bg_fame', 'bg_generation', 'bg_herd', 'bg_influence', 'bg_mentor', 'bg_resources', 'bg_retainers', 'bg_rituals', 'bg_status', 'hab_autocontrole_ref', 'hab_coragem_ref'}" fontColor="#ECE8E1" fontSize="11" margins="{right=8}"/>
                <label align="left" width="46" text="Bônus:" fontColor="#9E9890" fontSize="11" horzTextAlign="trailing" margins="{right=4}"/>
                <edit align="left" width="42" field="roll_bonus_dice" type="number" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center" margins="{right=8}"/>
                <label align="left" width="28" text="Dif:" fontColor="#9E9890" fontSize="11" horzTextAlign="trailing" margins="{right=4}"/>
                <edit align="left" width="40" field="roll_diff" type="number" fontColor="#D9B45B" fontSize="12" fontStyle="bold" horzTextAlign="center" margins="{right=8}"/>
                <button align="right" width="142" text="ROLAR NO CHAT" fontSize="12" fontStyle="bold">
                    <event name="onClick">if sheet ~= nil then V20Bridge.rollFromSheet(sheet) end</event>
                </button>
            </layout>
            <layout align="top" height="28" margins="{top=4}">
                <checkBox align="left" width="82" field="roll_usar_espec" text="Espec. (10=2)" fontColor="#ECE8E1" fontSize="10"/>
                <checkBox align="left" width="84" field="roll_gastar_fdv" text="+1 FdV Auto" fontColor="#D9B45B" fontSize="10"/>
                <checkBox align="left" width="76" field="roll_usar_fama" text="Usar Fama" fontColor="#ECE8E1" fontSize="10"/>
                <checkBox align="left" width="82" field="roll_usar_status" text="Usar Status" fontColor="#ECE8E1" fontSize="10"/>
                <checkBox align="left" width="106" field="roll_ignorar_ferimento" text="Ignorar Ferim." fontColor="#ECE8E1" fontSize="10"/>
                <label align="client" field="roll_equacao_resumo" fontColor="#9E9890" fontSize="11" horzTextAlign="trailing"/>
            </layout>
        </rectangle>

        <tabControl name="pgcPrincipal" align="client" margins="{left=6, right=6, top=6, bottom=6}">
            <tab name="tabCriacao" title="1. Personagem &amp; Criação">
                <scrollBox align="client" padding="{left=10, right=10, top=10, bottom=10}">
                    <layout align="top" height="720">
                        <rectangle align="top" height="175" color="#16161E" strokeColor="#3A1C24" strokeSize="1" xradius="6" yradius="6" padding="{left=12, right=12, top=10, bottom=10}" margins="{bottom=10}">
                            <label align="top" height="22" text="IDENTIDADE CAINITA — CLÃ BRUJAH" fontColor="#9E1B24" fontSize="13" fontStyle="bold" horzTextAlign="leading"/>
                            <layout align="top" height="28" margins="{top=6}">
                                <label align="left" width="75" text="Jogador:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <edit align="left" width="180" field="jogador" fontColor="#ECE8E1" fontSize="11" margins="{right=10}"/>
                                <label align="left" width="70" text="Crônica:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <edit align="left" width="190" field="cronica" fontColor="#ECE8E1" fontSize="11" margins="{right=10}"/>
                                <label align="left" width="70" text="Conceito:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <edit align="client" field="conceito" fontColor="#ECE8E1" fontSize="11"/>
                            </layout>
                            <layout align="top" height="28" margins="{top=6}">
                                <label align="left" width="75" text="Natureza:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <edit align="left" width="180" field="natureza" fontColor="#ECE8E1" fontSize="11" margins="{right=10}"/>
                                <label align="left" width="70" text="Comport.:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <edit align="left" width="190" field="comportamento" fontColor="#ECE8E1" fontSize="11" margins="{right=10}"/>
                                <label align="left" width="70" text="Senhor:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <edit align="client" field="senhor_regente" fontColor="#ECE8E1" fontSize="11"/>
                            </layout>
                            <layout align="top" height="28" margins="{top=6}">
                                <label align="left" width="95" text="Geração Base:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <edit align="left" width="44" field="geracao_base" type="number" fontColor="#D9B45B" fontSize="11" horzTextAlign="center" margins="{right=10}"/>
                                <label align="left" width="105" text="Geração Efetiva:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <label align="left" width="38" field="geracao" fontColor="#D9B45B" fontSize="12" fontStyle="bold" horzTextAlign="center" margins="{right=14}"/>
                                <label align="left" width="85" text="Modo Ficha:" fontColor="#9E9890" fontSize="11" horzTextAlign="leading"/>
                                <comboBox align="left" width="210" field="modo_ficha" items="{'Criação Validada (7/5/3)', 'Modo Jogo (XP)', 'Edição Livre (Narrador)'}" values="{'criacao', 'jogo', 'narrador_livre'}" fontColor="#ECE8E1" fontSize="11"/>
                            </layout>
                        </rectangle>

                        <rectangle align="top" height="250" color="#16161E" strokeColor="#3A1C24" strokeSize="1" xradius="6" yradius="6" padding="{left=12, right=12, top=10, bottom=10}" margins="{bottom=10}">
                            <label align="top" height="22" text="ASSISTENTE DE CRIAÇÃO NEÓFITO V20 (7/5/3 • 13/9/5 • 15 PONTOS DE BÔNUS)" fontColor="#9E1B24" fontSize="12" fontStyle="bold" horzTextAlign="leading"/>
                            <label align="top" height="20" text="Informe os pontos extras comprados com Pontos de Bônus (Atrib: 5, Hab: 2, Disc: 7, Antec: 1, Virt: 2, Moral: 1, FdV: 1):" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
                            <layout align="top" height="28" margins="{top=6}">
                                <label align="left" width="85" text="Bônus Atrib:" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
                                <edit align="left" width="40" field="freebie_attributes" type="number" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center" margins="{right=10}"/>
                                <label align="left" width="80" text="Bônus Hab:" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
                                <edit align="left" width="40" field="freebie_abilities" type="number" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center" margins="{right=10}"/>
                                <label align="left" width="80" text="Bônus Disc:" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
                                <edit align="left" width="40" field="freebie_disciplines" type="number" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center" margins="{right=10}"/>
                                <label align="left" width="85" text="Bônus Antec:" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
                                <edit align="left" width="40" field="freebie_backgrounds" type="number" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center"/>
                            </layout>
                            <layout align="top" height="28" margins="{top=4}">
                                <label align="left" width="85" text="Bônus Virt:" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
                                <edit align="left" width="40" field="freebie_virtues" type="number" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center" margins="{right=10}"/>
                                <label align="left" width="80" text="Bônus Moral:" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
                                <edit align="left" width="40" field="freebie_morality" type="number" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center" margins="{right=10}"/>
                                <label align="left" width="80" text="Bônus FdV:" fontColor="#9E9890" fontSize="10" horzTextAlign="leading"/>
                                <edit align="left" width="40" field="freebie_willpower" type="number" fontColor="#ECE8E1" fontSize="11" horzTextAlign="center" margins="{right=14}"/>
                                <button align="left" width="160" text="Rolar 1d10 Vitae Inicial" fontSize="11">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.rollInitialBlood(sheet) end</event>
                                </button>
                            </layout>
                            <layout align="top" height="32" margins="{top=8}">
                                <button align="left" width="150" text="Validar Criação V20" fontSize="11" margins="{right=8}">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.validateCreationOnSheet(sheet, nil, nil, nil, false) end</event>
                                </button>
                                <button align="left" width="245" text="Concluir Criação -&gt; Modo Jogo" fontSize="11" fontStyle="bold">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.validateCreationOnSheet(sheet, nil, nil, nil, true) end</event>
                                </button>
                            </layout>
                            <label align="client" field="criacao_resumo_status" wordWrap="true" fontColor="#D9B45B" fontSize="11" horzTextAlign="leading" margins="{top=6}"/>
                        </rectangle>

                        <rectangle align="top" height="120" color="#16161E" strokeColor="#9E1B24" strokeSize="1" xradius="6" yradius="6" padding="{left=12, right=12, top=10, bottom=10}">
                            <label align="top" height="22" text="FRAQUEZA HEREDITÁRIA DO CLÃ BRUJAH" fontColor="#9E1B24" fontSize="12" fontStyle="bold" horzTextAlign="leading"/>
                            <label align="client" text="+2 na dificuldade para resistir ao Frenesi (máx. 10); não pode gastar FdV para evitar o Frenesi, apenas 1 FdV para encerrá-lo após começar (V20, p. 49)." wordWrap="true" fontColor="#ECE8E1" fontSize="11" horzTextAlign="leading"/>
                        </rectangle>
                    </layout>
                </scrollBox>
            </tab>
            <tab name="tabAtributos" title="2. Atributos &amp; Habilidades">
                <scrollBox align="client" padding="{left=10, right=10, top=10, bottom=10}">
                    <layout align="top" height="760">
                        <rectangle align="top" height="158" color="#16161E" strokeColor="#3A1C24" strokeSize="1" xradius="6" yradius="6" padding="{left=10, right=10, top=8, bottom=8}" margins="{bottom=10}">
                            <layout align="top" height="22">
                                <label align="left" width="380" text="ATRIBUTOS V20 (CLIQUE NO NOME PARA CARREGAR NA PARADA)" fontColor="#9E1B24" fontSize="12" fontStyle="bold" horzTextAlign="leading"/>
                                <button align="right" width="175" text="Encerrar Cena (Limpar Buffs)" fontSize="10"><event name="onClick">if sheet ~= nil then V20Bridge.clearSceneBuffs(sheet) end</event></button>
                            </layout>
                            <layout align="client" margins="{top=4}">
                            <layout align="left" width="305" margins="{right=8}">
                                <label align="top" height="20" text="FÍSICOS" fontColor="#9E1B24" fontSize="11" fontStyle="bold" horzTextAlign="center"/>
                        <layout align="top" height="28" margins="{bottom=2}">
                            <button align="left" width="118" text="Força" fontSize="10" horzTextAlign="leading" hint="Selecionar na parada de dados">
                                <event name="onClick">if sheet ~= nil then V20Bridge.selectRollTrait(sheet, 'attr', 'attr_forca') end</event>
                            </button>
                            <button align="left" width="22" text="-" fontSize="11">
                                <event name="onClick">if sheet ~= nil then V20Bridge.adjustResource(sheet, 'attr_forca', -1, 1, 'atributo_max_geracao') end</event>
                            </button>
                            <edit align="left" width="34" field="attr_forca" type="number" fontColor="#D9B45B" fontSize="11" fontStyle="bold" horzTextAlign="center"/>
                            <button align="left" width="22" text="+" fontSize="11">
                                <event name="onClick">if sheet ~= nil then V20Bridge.adjustResource(sheet, 'attr_forca', 1, 1, 'atributo_max_geracao') end</event>
                            </button>
                            <button align="right" width="44" text="+Buff" fontSize="9" hint="Blood Buff (+1 Físico por 1 Vitae)" margins="{left=3}"><event name="onClick">if sheet ~= nil then V20Bridge.applyBloodBuff(sheet, 'forca') end</event></button><label align="right" width="22" field="buff_forca" fontColor="#E05A5A" fontSize="10" fontStyle="bold" horzTextAlign="center"/>
                            <edit align="client" field="spec_attr_forca" textPrompt="Especialidade" fontColor="#9E9890" fontSize="10" margins="{left=4}"/>
                        </layout>
                        <layout align="top" height="28" margins="{bottom=2}">
                            <button align="left" width="118" text="Destreza" fontSize="10" horzTextAlign="leading" hint="Selecionar na parada de dados">
                                <event name="onClick">if sheet ~= nil then V20Bridge.selectRollTrait(sheet, 'attr', 'attr_destreza') end</event>
                            </button>
                            <button align="left" width="22" text="-" fontSize="11">
                                <event name="onClick">if sheet ~= nil then V20Bridge.adjustResource(sheet, 'attr_destreza', -1, 1, 'atributo_max_geracao') end</event>
                            </button>
                            <edit align="left" width="34" field="attr_destreza" type="number" fontColor="#D9B45B" fontSize="11" fontStyle="bold" horzTextAlign="center"/>
                            <button align="left" width="22" text="+" fontSize="11">
                                <event name="onClick">if sheet ~= nil then V20Bridge.adjustResource(sheet, 'attr_destreza', 1, 1, 'atributo_max_geracao') end</event>
                            </button>
                            <button align="right" width="44" text="+Buff" fontSize="9" hint="Blood Buff (+1 Físico por 1 Vitae)" margins="{left=3}"><event name="onClick">if sheet ~= nil then V20Bridge.applyBloodBuff(sheet, 'destreza') end</event></button><label align="right" width="22" field="buff_destreza" fontColor="#E05A5A" fontSize="10" fontStyle="bold" horzTextAlign="center"/>
                            <edit align="client" field="spec_attr_destreza" textPrompt="Especialidade" fontColor="#9E9890" fontSize="10" margins="{left=4}"/>
                        </layout>
                        <layout align="top" height="28" margins="{bottom=2}">
                            <button align="left" width="118" text="Vigor" fontSize="10" horzTextAlign="leading" hint="Selecionar na parada de dados">
                                <event name="onClick">if sheet ~= nil then V20Bridge.selectRollTrait(sheet, 'attr', 'attr_vigor') end</event>
                            </button>
                            <button align="left" width="22" text="-" fontSize="11">
                                <event name="onClick">if sheet ~= nil then V20Bridge.adjustResource(sheet, 'attr_vigor', -1, 1, 'atributo_max_geracao') end</event>
                            </button>
                            <edit align="left" width="34" field="attr_vigor" type="number" fontColor="#D9B45B" fontSize="11" fontStyle="bold" horzTextAlign="center"/>
                            <button align="left" width="22" text="+" fontSize="11">
                                <event name="onClick">if sheet ~= nil then V20Bridge.adjustResource(sheet, 'attr_vigor', 1, 1, 'atributo_max_geracao') end</event>
                            </button>
                            <button align="right" width="44" text="+Buff" fontSize="9" hint="Blood Buff (+1 Físico por 1 Vitae)" margins="{left=3}"><event name="onClick">if sheet ~= nil then V20Bridge.applyBloodBuff(sheet, 'vigor') end</event></button><label align="right" width="22" field="buff_vigor" fontColor="#E05A5A" fontSize="10" fontStyle="bold" horzTextAlign="center"/>
                            <edit align="client" field="spec_attr_vigor" textPrompt="Especialidade" fontColor="#9E9890" fontSize="10" margins="{left=4}"/>
                        </layout>
                            </layout>
                            <layout align="left" width="305" margins="{right=8}">
                                <label align="top" height="20" text="SOCIAIS" fontColor="#9E1B24" fontSize="11" fontStyle="bold" horzTextAlign="center"/>
                        <layout align="top" height="28" margins="{bottom=2}">
                            <button align="left" width="118" text="Carisma" fontSize="10" horzTextAlign="leading" hint="Selecionar na parada de dados">
                                <event name="onClick">if sheet ~= nil then V20Bridge.selectRollTrait(sheet, 'attr', 'attr_carisma') end</event>
                            </button>
                            <button align="left" width="22" text="-" fontSize="11">
                                <event name="onClick">if sheet ~= nil then V20Bridge.adjustResource(sheet, 'attr_carisma', -1, 1, 'atributo_max_geracao') end</event>
                            </button>
