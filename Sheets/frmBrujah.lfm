                                <checkBox align="left" width="56" field="mf_slot4_ativo" text="Ativo" fontColor="#ECE8E1" fontSize="10"/>
                                <comboBox align="left" width="255" field="mf_slot4_id" items="{'— Selecionar Catálogo / Custom —', 'Qualidade: Sentidos Aguçados (1 pt, -2 dif Percepção)', 'Qualidade: Ambidestro (1 pt)', 'Qualidade: Vontade de Ferro (3 pts)', 'Qualidade: Tamanho Grande (4 pts, +1 Escoriado)', 'Qualidade: Disciplina Adicional (5 pts)', 'Defeito: 14ª Geração / Sangue-Fraco (+2 pts)', 'Defeito: 15ª Geração / Sangue-Fraco (+4 pts)', 'Defeito: Deficiência Visual (+1 pt, +2 dif Percepção)', 'Personalizada / Outra do V20 Corebook'}" values="{'', 'acute_senses', 'ambidextrous', 'iron_will', 'huge_size', 'additional_disc', 'gen_14th', 'gen_15th', 'bad_sight', 'custom'}" fontColor="#ECE8E1" fontSize="10" margins="{right=6}"/>
                                <edit align="client" field="mf_slot4_nome" textPrompt="Descrição / Qualidade Customizada" fontColor="#9E9890" fontSize="10" margins="{right=6}"/>
