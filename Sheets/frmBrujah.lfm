            <tab name="tabDisciplinas" title="3. Disciplinas &amp; Poderes">
                <scrollBox align="client" padding="{left=10, right=10, top=10, bottom=10}">
                    <layout align="top" height="860">
                        <rectangle align="top" height="72" color="#16161E" strokeColor="#9E1B24" strokeSize="1" xradius="6" yradius="6" padding="{left=12, right=12, top=8, bottom=8}" margins="{bottom=8}">
                            <layout align="top" height="26">
                                <label align="left" width="135" text="MODIFICADORES ATIVOS:" fontColor="#9E1B24" fontSize="11" fontStyle="bold" horzTextAlign="leading"/>
                                <label align="client" field="buffs_cena_resumo" fontColor="#D9B45B" fontSize="11" horzTextAlign="leading"/>
                                <button align="right" width="135" text="Potência Automática" fontSize="10" margins="{left=4}">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.activateDisciplinePower(sheet, 'potence', 'pot_1') end</event>
                                </button>
                                <button align="right" width="125" text="+1 Ação Rapidez" fontSize="10" margins="{left=4}">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.activateDisciplinePower(sheet, 'celerity', 'cel_1') end</event>
                                </button>
                                <button align="right" width="120" text="Limpar Buffs Cena" fontSize="10" margins="{left=4}">
                                    <event name="onClick">if sheet ~= nil then V20Bridge.clearSceneBuffs(sheet) end</event>
                                </button>
                            </layout>
                            <label align="client" text="Catálogo Universal V20: todas as 17 Disciplinas Clássicas (incluindo Taumaturgia, Necromancia e Tenebrosidade) disponíveis em qualquer slot." fontColor="#9E9890" fontSize="10" horzTextAlign="leading" margins="{top=4}"/>
                        </rectangle>

                        <rectangle align="top" height="62" color="#16161E" strokeColor="#3A1C24" strokeSize="1" xradius="5" yradius="5" padding="{left=10, right=10, top=6, bottom=6}" margins="{bottom=6}">
                            <layout align="top" height="26">
                                <label align="left" width="66" text="CLÃ #1" fontColor="#9E1B24" fontSize="10" fontStyle="bold" horzTextAlign="leading"/>
                                <comboBox align="left" width="185" field="disc_slot1_id" items="{'— Nenhuma —', 'Animalismo', 'Auspícios', 'Rapidez', 'Quimerismo', 'Demência', 'Dominação', 'Fortitude', 'Necromancia (Sepulcro)', 'Ofuscação', 'Tenebrosidade', 'Potência', 'Presença', 'Metamorfose', 'Quietus', 'Serpentis', 'Taumaturgia (Sangue)', 'Vicissitude'}" values="{'', 'animalism', 'auspex', 'celerity', 'chimerstry', 'dementation', 'dominate', 'fortitude', 'necromancy', 'obfuscate', 'obtenebration', 'potence', 'presence', 'protean', 'quietus', 'serpentis', 'thaumaturgy', 'vicissitude'}" fontColor="#ECE8E1" fontSize="11" margins="{right=6}"/>
