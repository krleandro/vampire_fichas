                                <edit align="left" width="34" field="arma1_dif" type="number" fontColor="#D9B45B" fontSize="11" horzTextAlign="center" margins="{right=4}"/>
                                <edit align="left" width="36" field="arma1_dano" type="number" fontColor="#E05A5A" fontSize="11" horzTextAlign="center" margins="{right=4}"/>
