                            <layout align="top" height="28" margins="{bottom=3}">
                                <edit align="left" width="155" field="arma4_nome" textPrompt="Arma / Manobra #4" fontColor="#ECE8E1" fontSize="11" margins="{right=6}"/>
                                <comboBox align="left" width="115" field="arma4_attr" items="{'Força', 'Destreza', 'Vigor', 'Carisma', 'Manipulação', 'Aparência', 'Percepção', 'Inteligência', 'Raciocínio'}" values="{'attr_forca', 'attr_destreza', 'attr_vigor', 'attr_carisma', 'attr_manipulacao', 'attr_aparencia', 'attr_percepcao', 'attr_inteligencia', 'attr_raciocinio'}" fontColor="#ECE8E1" fontSize="10" margins="{right=4}"/>
                                <comboBox align="left" width="135" field="arma4_hab" items="{'Prontidão', 'Esportes', 'Consciência', 'Briga', 'Empatia', 'Expressão', 'Intimidação', 'Liderança', 'Manha', 'Lábia', 'Empatia c/ Animais', 'Ofícios', 'Condução', 'Etiqueta', 'Armas de Fogo', 'Arrombamento', 'Armas Brancas', 'Performance', 'Furtividade', 'Sobrevivência', 'Acadêmicos', 'Computador', 'Finanças', 'Investigação', 'Direito', 'Medicina', 'Ocultismo', 'Política', 'Ciências', 'Tecnologia', 'Autocontrole/Instinto', 'Coragem'}" values="{'hab_prontidao', 'hab_esportes', 'hab_consciencia', 'hab_briga', 'hab_empatia', 'hab_expressao', 'hab_intimidacao', 'hab_lideranca', 'hab_manha', 'hab_labia', 'hab_empatia_animais', 'hab_oficios', 'hab_conducao', 'hab_etiqueta', 'hab_armas_fogo', 'hab_arrombamento', 'hab_armas_brancas', 'hab_performance', 'hab_furtividade', 'hab_sobrevivencia', 'hab_academicos', 'hab_computador', 'hab_financas', 'hab_investigacao', 'hab_direito', 'hab_medicina', 'hab_ocultismo', 'hab_politica', 'hab_ciencias', 'hab_tecnologia', 'hab_autocontrole_ref', 'hab_coragem_ref'}" fontColor="#ECE8E1" fontSize="10" margins="{right=4}"/>
                                <edit align="left" width="34" field="arma4_dif" type="number" fontColor="#D9B45B" fontSize="11" horzTextAlign="center" margins="{right=4}"/>
                                <edit align="left" width="36" field="arma4_dano" type="number" fontColor="#E05A5A" fontSize="11" horzTextAlign="center" margins="{right=4}"/>
                                <comboBox align="left" width="105" field="arma4_tipo" items="{'Contundente', 'Letal', 'Agravado'}" values="{'bashing', 'lethal', 'aggravated'}" fontColor="#ECE8E1" fontSize="10" margins="{right=4}"/>
                                <edit align="client" field="arma4_municao" textPrompt="Munição" fontColor="#9E9890" fontSize="10" margins="{right=6}"/>
